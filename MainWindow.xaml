<Window x:Class="VGCASignToolPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Controls.RichTextBoxAdv;assembly=Syncfusion.SfRichTextBoxAdv.Wpf"
        mc:Ignorable="d"
        Title="VGCA Sign Tool Pro - Hệ Thống Ký Số Điện Tử &amp; Soạn Thảo Văn Bản Tích Hợp" 
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Chính (Xanh dương) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#94A3B8" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Chuyển đổi (Cam / Hổ phách) -->
        <Style x:Key="ConvertButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Ký số Cá nhân (Xanh dương hoàng gia - Primary Action) -->
        <Style x:Key="SignButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Đóng Dấu Pháp Nhân Cơ Quan (Đỏ Quốc Gia Ban Cơ Yếu) -->
        <Style x:Key="OfficialSealButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Word (Xanh dương nhẹ) -->
        <Style x:Key="ToolbarWordButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E40AF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Excel (Xanh lá cây nhẹ) -->
        <Style x:Key="ToolbarExcelButton" TargetType="Button">
            <Setter Property="Background" Value="#F0FDF4" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#15803D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File PDF (Xám thanh lịch) -->
        <Style x:Key="ToolbarPdfButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Thành công (Xanh lá) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10B981" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Phụ (Xám nhạt) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Soạn thảo Mini -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>

        <!-- STYLE TABCONTROL CHUẨN MICROSOFT FLUENT DESIGN (SEGMENTED NAVIGATION BAR) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- THANH ĐIỀU HƯỚNG TABS TÁCH BIỆT (FLUENT SEGMENTED TRACK) -->
                            <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="8" Padding="5" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            
                            <!-- VÙNG NỘI DUNG CHÍNH (CONTENT PRESENTER) -->
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TABITEM CHUẨN MICROSOFT FLUENT DESIGN (HIGH-CONTRAST ACCENT PILL) -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                CornerRadius="6" 
                                Padding="18,8"
                                BorderThickness="0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- KHI DI CHUỘT QUA TAB CHƯA CHỌN (HOVER) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </MultiTrigger>
                            
                            <!-- KHI ĐƯỢC CHỌN (SELECTED - ĐỔI MÀU NỔI BẬT CHUẨN MICROSOFT FLUENT) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="TabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#1E40AF" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            
                            <!-- KHI BỊ KHÓA (DISABLED) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VGCA SIGN TOOL PRO" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ký số PAdES Ban Cơ yếu Chính phủ • Soạn thảo &amp; Xem trực tiếp Word/PDF • Cổng Web" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- NÚT KIỂM TRA CẬP NHẬT PHIÊN BẢN MỚI TỪ FIREBASE -->
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" 
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,6" Margin="0,0,10,0" Cursor="Hand" ToolTip="Kiểm tra phiên bản cập nhật mới từ hệ thống nhà trường (Firebase &amp; GitHub)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtUpdateStatusHeader" Text="Kiểm Tra Cập Nhật" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- BADGE TRẠNG THÁI VGCA TOÀN CỤC -->
                    <Border x:Name="BadgeVgcaGlobalStatus" Background="#B91C1C" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVgcaGlobalStatusIcon" Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtVgcaGlobalStatusText" Text="VGCA: Chưa Đăng Nhập" 
                                       Foreground="#FEF2F2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14,10,14,10" Background="Transparent" BorderThickness="0">

            <!-- ================= TAB 1: THÔNG TIN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <TabItem Header="  1. 👤 Tài Khoản Ký Số  " FontSize="13" FontWeight="SemiBold">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="520" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: KHUNG ĐĂNG NHẬP VGCA VIRTUAL CSP & THÔNG TIN CHỨNG THƯ -->
                        <StackPanel Grid.Column="0">
                            <!-- PANEL 1: KHI CHƯA ĐĂNG NHẬP - GIAO DIỆN ĐĂNG NHẬP GIÁO VIÊN (CCCD + MẬT KHẨU TỪ HTML) -->
                            <GroupBox x:Name="GrpVgcaLoginBox" Header="Đăng Nhập Tài Khoản Ký Số Giáo Viên (Ban Cơ Yếu Chính Phủ)">
                                <StackPanel Margin="6">
                                    <!-- BANNER GIỚI THIỆU -->
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="HỆ THỐNG KÝ SỐ LIÊN THÔNG GIÁO DỤC" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Đăng nhập bằng số Căn cước công dân và mật khẩu được cấp bởi Nhà trường để kích hoạt phiên làm việc và phân quyền ký số / đóng dấu." 
                                                       TextWrapping="Wrap" FontSize="11" Foreground="#1E40AF" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- FORM ĐĂNG NHẬP CHÍNH (CCCD + MẬT KHẨU) -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Số Căn Cước Công Dân (12 số):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4" />
                                            <TextBox x:Name="TxtLoginCccd" FontSize="13" Padding="8,6" Margin="0,0,0,10" MaxLength="12" FontFamily="Consolas" KeyDown="TxtLoginInput_KeyDown" />

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Mật Khẩu Đăng Nhập:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" HorizontalAlignment="Left" />
                                                <TextBlock Text="(Mặc định: 123456)" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                            </Grid>
                                            <PasswordBox x:Name="TxtLoginPassword" FontSize="13" Padding="8,6" Margin="0,0,0,14" KeyDown="TxtLoginInput_KeyDown" />

                                            <!-- NÚT ĐĂNG NHẬP CHÍNH -->
                                            <Button x:Name="BtnSubmitLogin" Content="🔑 ĐĂNG NHẬP HỆ THỐNG" Style="{StaticResource PrimaryButton}" 
                                                    Background="#2563EB" FontSize="13" FontWeight="Bold" Padding="14,10" Margin="0,0,0,6" Click="BtnSubmitLogin_Click" HorizontalAlignment="Stretch" />

                                            <TextBlock Text="* Ghi chú: Mật khẩu và phân quyền đóng dấu do Quản trị viên thiết lập từ file HTML/Web. Quên mật khẩu xin liên hệ BGH." 
                                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- NÚT ĐỒNG BỘ VÀ NHẬN DIỆN CHỨNG THƯ TRỰC TIẾP TỪ VGCA VIRTUAL CSP (TÙY CHỌN DỰ PHÒNG) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnSyncVgcaCertificate" Content="🔄 Quét Token Cắm Sẵn" Style="{StaticResource SecondaryButton}" 
                                                FontSize="11" FontWeight="SemiBold" Padding="8,8" Margin="0,0,4,0" Click="BtnSyncVgcaCertificate_Click" />
                                        <Button Grid.Column="1" x:Name="BtnLaunchVgcaManager" Content="🖥️ Mở Virtual CSP" Style="{StaticResource SecondaryButton}" 
                                                FontSize="11" FontWeight="SemiBold" Padding="8,8" Margin="4,0,0,0" Click="BtnLaunchVgcaManager_Click" />
                                    </Grid>

                                    <!-- KHUNG THÔNG BÁO LỖI / TRẠNG THÁI -->
                                    <Border x:Name="BorderVgcaAuthError" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16" />
                                            <TextBlock x:Name="TxtVgcaAuthError" Text="Chưa phát hiện chứng thư số Ban Cơ yếu trong Windows..." Foreground="#991B1B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- PANEL 2: KHI ĐÃ ĐĂNG NHẬP THÀNH CÔNG - THẺ CHỨNG THƯ HOẠT ĐỘNG -->
                            <GroupBox x:Name="GrpVgcaActiveCard" Header="Tài Khoản Ký Số Đang Hoạt Động (Ban Cơ Yếu Chính Phủ)" Visibility="Collapsed">
                                <StackPanel Margin="4">
                                    <!-- BANNER XÁC THỰC THÀNH CÔNG -->
                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛡️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="PHIÊN ĐĂNG NHẬP ĐÃ XÁC THỰC" FontWeight="Bold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Đã sẵn sàng ký số tài liệu chuẩn PAdES LTV theo Nghị định 30/2020/NĐ-CP." FontSize="11" Foreground="#166534" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="🔑 Đổi Mật Khẩu" Style="{StaticResource SecondaryButton}" 
                                                        Background="#EEF2FF" BorderBrush="#C7D2FE" Foreground="#3730A3" FontWeight="Bold" 
                                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnChangePasswordLocal_Click" />
                                                <Button Content="🚪 Đăng Xuất" Style="{StaticResource SecondaryButton}" 
                                                        Background="#FEE2E2" BorderBrush="#FCA5A5" Foreground="#991B1B" FontWeight="Bold" 
                                                        Padding="8,4" FontSize="11" Click="BtnVgcaLogout_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- KHUNG THÔNG TIN CHI TIẾT CHỨNG THƯ -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
