                                                Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,4,0" 
                                                Click="BtnSaveProfile_Click" />
                                        <Button Grid.Column="1" Content="👉 Sang Soạn Thảo &amp; Ký Số ➡" 
                                                Style="{StaticResource PrimaryButton}" Padding="10,8" Margin="4,0,0,0" 
                                                Click="BtnGoToSignWorkspace_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: SOẠN THẢO & KÝ SỐ VĂN BẢN TRỰC TIẾP ================= -->
            <TabItem x:Name="TabItemSignWorkspace" Header="  2. ✍️ Soạn Thảo &amp; Ký Số ( 🔒 Khóa )  " IsEnabled="False" FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="GridTab2Root" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- HÀNG 0: THANH CÔNG CỤ ĐIỀU KHIỂN & SOẠN THẢO TRÊN CÙNG -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 1: BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 2: KHUNG HIỂN THỊ TÀI LIỆU TRỰC TIẾP TOÀN MÀN HÌNH -->
                        <RowDefinition Height="*" />
                        <!-- HÀNG 3: NHẬT KÝ TIẾN TRÌNH RÚT GỌN CHÂN TRANG -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ ĐIỀU HÀNH VĂN BẢN (TOOLBAR) -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DÒNG 1: TẢI FILE & CÁC NÚT HÀNH ĐỘNG CHÍNH -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- NÚT 1: MỞ FILE WORD -->
                                <Button Grid.Column="0" x:Name="BtnSelectWord" Content="📄 Mở File Word" 
                                        Style="{StaticResource ToolbarWordButton}" 
                                        Click="BtnSelectWord_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở văn bản Microsoft Word (.docx) để xem, chỉnh sửa và ký số" />

                                <!-- NÚT 2: MỞ BẢNG TÍNH EXCEL -->
                                <Button Grid.Column="1" x:Name="BtnSelectExcel" Content="📊 Mở File Excel" 
                                        Style="{StaticResource ToolbarExcelButton}" 
                                        Click="BtnSelectExcel_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở bảng tính Microsoft Excel (.xlsx, .xls) để xem, điều chỉnh và ký số" />

                                <!-- NÚT 3: MỞ FILE PDF TRỰC TIẾP -->
                                <Button Grid.Column="2" x:Name="BtnSelectPdf" Content="📑 Mở File PDF" 
                                        Style="{StaticResource ToolbarPdfButton}" 
                                        Click="BtnSelectPdf_Click" Margin="0,0,10,0" 
                                        ToolTip="Mở trực tiếp tài liệu PDF để ký số điện tử" />

                                <!-- TÊN FILE & TRẠNG THÁI HIỆN TẠI KÈM NÚT ĐÓNG TỆP AN TOÀN -->
                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentFileName" Text="Chưa chọn tệp tin nào." FontWeight="Bold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TxtCurrentFileStatus" Text="Chọn file Word, Excel hoặc PDF để làm việc." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCloseCurrentFile" Content="✕ Đóng Tệp" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2"
                                            Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                            Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="BtnCloseCurrentFile_Click" 
                                            ToolTip="Đóng an toàn tệp đang mở và giải phóng bộ nhớ hệ thống" />
                                </Grid>

                                <!-- NÚT 4: CHUYỂN QUA PDF ĐỂ KÝ -->
                                <Button Grid.Column="4" x:Name="BtnConvertToPdfAndReadySign" 
                                        Content="⚡ Chuyển PDF Để Ký" 
                                        Style="{StaticResource ConvertButton}" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnExecuteConvertDocument_Click" 
                                        ToolTip="Chuyển đổi văn bản sang định dạng chuẩn PDF để sẵn sàng ký số" />

                                <!-- NÚT 5: CHÈN CHỮ KÝ (KÉO THẢ TRỰC TIẾP TRÊN TRANG VĂN BẢN) -->
                                <Button Grid.Column="5" x:Name="BtnInsertSignatureStamp" 
                                        Content="📍 Chèn Vị Trí Ký" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnInsertSignatureStamp_Click" 
                                        ToolTip="Nhấp chuột để chọn vị trí đóng dấu / ký tên trực tiếp trên trang tài liệu" />

                                <!-- NÚT 6: KÝ CÁ NHÂN -->
                                <Button Grid.Column="6" x:Name="BtnSignCurrentDocument" 
                                        Content="✍️ Ký Cá Nhân" 
                                        Style="{StaticResource SignButton}" 
                                        IsEnabled="False" 
                                        Click="BtnSignDocument_Click" 
                                        ToolTip="Thực hiện ký số cá nhân giáo viên chuẩn PAdES theo Nghị định 30/2020/NĐ-CP" />

                                <!-- NÚT 7: ĐÓNG DẤU (USB TOKEN BAN CƠ YẾU) -->
                                <Button Grid.Column="7" x:Name="BtnStampOfficial" 
                                        Content="🔴 Đóng dấu" 
                                        Style="{StaticResource OfficialSealButton}" 
                                        IsEnabled="False" Margin="6,0,0,0"
                                        Click="BtnStampOfficial_Click" 
                                        ToolTip="Đóng dấu pháp nhân trường học bằng USB Token Ban Cơ yếu (Dành cho Ban Giám hiệu / Văn thư)" />
                            </Grid>

                            <!-- DÒNG 2: THANH CÔNG CỤ ĐIỀU CHỈNH VĂN BẢN TRỰC TIẾP (KHI MỞ FILE WORD HOẶC EXCEL) -->
                            <Grid Grid.Row="1" x:Name="PnlEditingToolbar" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtEditorModeBadge" Text="✏ Soạn thảo &amp; Điều chỉnh trực tiếp" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                    <Button Content="B" ToolTip="In đậm (Bold)" Style="{StaticResource FormatButton}" Click="BtnFormatBold_Click" />
                                    <Button Content="I" ToolTip="In nghiêng (Italic)" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="BtnFormatItalic_Click" />
                                    <Button Content="U" ToolTip="Gạch chân (Underline)" Style="{StaticResource FormatButton}" Click="BtnFormatUnderline_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button Content="⇤ Trái" ToolTip="Căn lề trái" Style="{StaticResource FormatButton}" Click="BtnAlignLeft_Click" />
                                    <Button Content="↔ Giữa" ToolTip="Căn giữa" Style="{StaticResource FormatButton}" Click="BtnAlignCenter_Click" />
                                    <Button Content="⇥ Phải" ToolTip="Căn lề phải" Style="{StaticResource FormatButton}" Click="BtnAlignRight_Click" />
                                    <Button Content="⇿ Đều" ToolTip="Căn đều hai bên" Style="{StaticResource FormatButton}" Click="BtnAlignJustify_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button x:Name="BtnSaveWordCopy" Content="💾 Lưu Bản Sao Word..." ToolTip="Lưu nội dung đã chỉnh sửa thành một tệp Word mới (bảo toàn tuyệt đối tệp gốc)" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnSaveWordCopy_Click" />

                                    <!-- NÚT ĐỊNH DẠNG KHỔ IN EXCEL (HIỆN KHI MỞ FILE EXCEL) -->
                                    <StackPanel x:Name="PnlExcelToolbarControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                        <Separator Width="1" Height="16" Margin="0,0,8,0" Background="#CBD5E1" />
                                        <Button Content="📄 Khổ Ngang A4" ToolTip="Định dạng in bảng tính theo khổ ngang A4" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnExcelLandscape_Click" />
                                        <Button Content="📄 Khổ Dọc A4" ToolTip="Định dạng in bảng tính theo khổ dọc A4" Style="{StaticResource FormatButton}" Padding="8,2" Margin="4,0,0,0" Click="BtnExcelPortrait_Click" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- THANH LOADING CHUYỂN ĐỔI -->
                                <ProgressBar Grid.Column="2" x:Name="PrgConvertLoading" Height="4" IsIndeterminate="True" 
                                             Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Foreground="#D97706" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- CHIP HIỂN THỊ ẢNH CON DẤU TRÊN TAB 2 -->
                                    <Border x:Name="BadgeTab2Stamp" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
