<Window x:Class="VGCASignToolPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="VGCA Sign Tool Pro - Hệ Thống Ký Số Điện Tử &amp; Soạn Thảo Văn Bản Tích Hợp" 
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Chính (Xanh dương) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#94A3B8" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Chuyển đổi (Cam / Hổ phách) -->
        <Style x:Key="ConvertButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Ký số (Đỏ Ban Cơ yếu) -->
        <Style x:Key="SignButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Thành công (Xanh lá) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10B981" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Phụ (Xám nhạt) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Soạn thảo Mini -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VGCA SIGN TOOL PRO" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ký số PAdES Ban Cơ yếu Chính phủ • Soạn thảo &amp; Xem trực tiếp Word/PDF • Cổng Web" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BADGE TRẠNG THÁI VGCA TOÀN CỤC -->
                    <Border x:Name="BadgeVgcaGlobalStatus" Background="#065F46" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVgcaGlobalStatusIcon" Text="✅" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtVgcaGlobalStatusText" Text="VGCA Virtual CSP: Đã Đăng Nhập" 
                                       Foreground="#ECFDF5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14,10,14,10" Background="Transparent" BorderThickness="0">

            <!-- ================= TAB 1: THÔNG TIN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <TabItem Header="  1. Thông Tin Chữ Ký Số (VGCA)  " FontSize="14" FontWeight="SemiBold">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="520" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: THÔNG TIN TÀI KHOẢN & CHỨNG THƯ VGCA ĐANG ĐĂNG NHẬP -->
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Thông Tin Tài Khoản Ký Số VGCA (Ban Cơ Yếu Chính Phủ)">
                                <StackPanel Margin="4">

                                    <!-- KHUNG CẢNH BÁO NẾU CHƯA ĐĂNG NHẬP -->
                                    <Border x:Name="PnlVgcaNotLoggedInWarning" Visibility="Collapsed" Background="#FEF2F2" 
                                            BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="⚠️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="CHƯA PHÁT HIỆN TÀI KHOẢN VGCA ĐĂNG NHẬP" FontWeight="Bold" 
                                                           Foreground="#991B1B" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Hệ thống chưa tìm thấy phiên đăng nhập tài khoản chữ ký số Ban Cơ yếu Chính phủ. Vui lòng mở ứng dụng VGCA Virtual CSP v2.0 để đăng nhập trước khi thực hiện ký số." 
                                                       TextWrapping="Wrap" FontSize="12" Foreground="#7F1D1D" LineHeight="18" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="🔑 Mở Ứng Dụng VGCA Virtual CSP Để Đăng Nhập" 
                                                        Style="{StaticResource PrimaryButton}" Background="#DC2626" 
                                                        Padding="12,8" Click="BtnLaunchVgcaManager_Click" />
                                                <Button Content="🔄 Quét Lại (F5)" Style="{StaticResource SecondaryButton}" 
                                                        Margin="8,0,0,0" Click="BtnRefreshCertificates_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- KHUNG THÔNG TIN CHI TIẾT KHI ĐÃ ĐĂNG NHẬP THÀNH CÔNG -->
                                    <Border x:Name="PnlVgcaLoggedInDetails" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- HỌ VÀ TÊN -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Người Ký (Chủ sở hữu):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDetailSignerName" Text="Hà Văn Tý" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" Margin="0,4" />

                                            <!-- EMAIL -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email Công Vụ:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDetailEmail" Text="hvty-dakha@quangngai.gov.vn" Foreground="#0F172A" Margin="0,4" />

                                            <!-- ĐƠN VỊ -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Đơn Vị Công Tác:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetailOrg" Text="TRƯỜNG THCS CHU VĂN AN - UBND XÃ ĐẮK HÀ - TỈNH QUẢNG NGÃI" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,4" />

                                            <!-- CƠ QUAN CẤP (CA) -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cơ Quan Cấp Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDetailIssuer" Text="CA phục vụ các cơ quan Nhà nước G2, Ban Cơ yếu Chính phủ" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- SỐ SERIAL -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Số Serial Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDetailSerial" Text="7C4C44A8671300AE" FontFamily="Consolas" Foreground="#0F172A" Margin="0,4" />

                                            <!-- HIỆU LỰC -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Thời Hạn Hiệu Lực:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtDetailValidity" Text="29/05/2026 đến 28/05/2031 (Đang hoạt động)" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THUẬT TOÁN KHÓA -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Thuật Toán Mật Mã:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDetailAlgorithm" Text="ECDSA 384-bit (ECC Curve P-384 / KSP)" Foreground="#D97706" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- THUMBPRINT -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Mã Băm (Thumbprint):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDetailThumbprint" Text="6398E3DC37E44EBBF976DFDE9F0143E1BDA5346D" FontFamily="Consolas" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                    </Border>

                                    <!-- DROPDOWN CHỌN CHỨNG THƯ (CHỈ HIỂN THỊ CHỨNG THƯ HỢP LỆ) -->
                                    <TextBlock Text="Danh sách chứng thư ký số phát hiện trên máy:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbCertificates" Padding="6" SelectionChanged="CmbCertificates_SelectionChanged" />
                                        <Button Grid.Column="1" Content="🔄 Quét Lại Token" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="8,4" Click="BtnRefreshCertificates_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- CỘT PHẢI: MẪU CHỮ KÝ & VỊ TRÍ KÝ MẶC ĐỊNH (SIGNER PROFILE) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Cấu Hình Mẫu Chữ Ký &amp; Vị Trí Mặc Định">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Chọn mẫu chữ ký chuẩn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CmbProfiles" Margin="0,0,0,8" Padding="6" SelectionChanged="CmbProfiles_SelectionChanged" />

                                    <TextBlock Text="Hình ảnh con dấu đỏ hoặc chữ ký tay quét:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtStampImagePath" IsReadOnly="True" 
                                                 Background="#F8FAFC" Padding="6" Text="Ảnh con dấu / Chữ ký tay (tùy chọn)..." />
                                        <Button Grid.Column="1" Content="🖼 Chọn Ảnh..." Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Click="BtnSelectStampImage_Click" />
                                    </Grid>

                                    <!-- VỊ TRÍ KÝ: TRANG, TỌA ĐỘ -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trang ký:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtPageNumber" Text="-1" Padding="4" ToolTip="-1 là trang cuối cùng" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tọa độ X:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordX" Text="380" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tọa độ Y:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordY" Text="120" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Rộng x Cao:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtDimensions" Text="120x120" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Họ tên người ký hiển thị:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSignerDisplayName" Padding="5" Margin="0,0,0,6" />

                                    <TextBlock Text="Lý do ký:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtReason" Text="Ký duyệt phát hành văn bản điện tử" Padding="5" Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkUseTSA" Content="Đóng Dấu thời gian TSA Ban Cơ yếu (http://ca.gov.vn/tsa)" 
                                              IsChecked="True" FontWeight="Normal" FontSize="11" Margin="0,0,0,14" />

                                    <!-- NÚT CHUYỂN SANG TAB KÝ VĂN BẢN -->
                                    <Button Content="👉 Đi Tới Soạn Thảo &amp; Ký Văn Bản (Tab 2) ➡" 
                                            Style="{StaticResource PrimaryButton}" Padding="16,10" 
                                            Click="BtnGoToSignWorkspace_Click" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: SOẠN THẢO & KÝ SỐ VĂN BẢN TRỰC TIẾP ================= -->
            <TabItem Header="  2. Soạn Thảo, Xem &amp; Ký Số Trực Tiếp  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- THANH CÔNG CỤ ĐIỀU KHIỂN & SOẠN THẢO TRÊN CÙNG -->
                        <RowDefinition Height="Auto" />
                        <!-- KHUNG HIỂN THỊ TÀI LIỆU TRỰC TIẾP TOÀN MÀN HÌNH -->
                        <RowDefinition Height="*" />
                        <!-- NHẬT KÝ TIẾN TRÌNH RÚT GỌN CHÂN TRANG -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ ĐIỀU HÀNH VĂN BẢN (TOOLBAR) -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DÒNG 1: TẢI FILE & CÁC NÚT HÀNH ĐỘNG CHÍNH -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- NÚT 1: TẢI FILE WORD -->
                                <Button Grid.Column="0" Content="📄 Tải File Word (.docx)" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Click="BtnSelectWord_Click" Margin="0,0,8,0" />

                                <!-- NÚT 2: TẢI FILE PDF TRỰC TIẾP -->
                                <Button Grid.Column="1" Content="📑 Tải File PDF" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Click="BtnSelectPdf_Click" Margin="0,0,12,0" />

                                <!-- TÊN FILE & TRẠNG THÁI HIỆN TẠI -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtCurrentFileName" Text="Chưa chọn tệp tin nào." FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                    <TextBlock x:Name="TxtCurrentFileStatus" Text="Chọn file Word hoặc PDF để xem trực tiếp tại đây." FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <!-- NÚT 3: CHUYỂN QUA PDF ĐỂ KÝ -->
                                <Button Grid.Column="3" x:Name="BtnConvertToPdfAndReadySign" 
                                        Content="⚡ Chuyển Qua PDF Để Ký" 
                                        Style="{StaticResource ConvertButton}" 
                                        IsEnabled="False" Margin="0,0,8,0" 
                                        Click="BtnExecuteConvertWord_Click" />

                                <!-- NÚT 4: TIẾN HÀNH KÝ SỐ TÀI LIỆU -->
                                <Button Grid.Column="4" x:Name="BtnSignCurrentDocument" 
                                        Content="✍ TIẾN HÀNH KÝ SỐ" 
                                        Style="{StaticResource SignButton}" 
                                        IsEnabled="False" 
                                        Click="BtnSignDocument_Click" />
                            </Grid>

                            <!-- DÒNG 2: THANH CÔNG CỤ ĐIỀU CHỈNH VĂN BẢN TRỰC TIẾP (KHI MỞ FILE WORD) -->
                            <Grid Grid.Row="1" x:Name="PnlEditingToolbar" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock Text="✏ Chế độ xem &amp; chỉnh sửa trực tiếp Word" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                    <Button Content="B" ToolTip="In đậm (Bold)" Style="{StaticResource FormatButton}" Click="BtnFormatBold_Click" />
                                    <Button Content="I" ToolTip="In nghiêng (Italic)" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="BtnFormatItalic_Click" />
                                    <Button Content="U" ToolTip="Gạch chân (Underline)" Style="{StaticResource FormatButton}" Click="BtnFormatUnderline_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button Content="⇤ Trái" ToolTip="Căn lề trái" Style="{StaticResource FormatButton}" Click="BtnAlignLeft_Click" />
                                    <Button Content="↔ Giữa" ToolTip="Căn giữa" Style="{StaticResource FormatButton}" Click="BtnAlignCenter_Click" />
                                    <Button Content="⇥ Phải" ToolTip="Căn lề phải" Style="{StaticResource FormatButton}" Click="BtnAlignRight_Click" />
                                    <Button Content="⇿ Đều" ToolTip="Căn đều hai bên" Style="{StaticResource FormatButton}" Click="BtnAlignJustify_Click" />
                                </StackPanel>

                                <!-- THANH LOADING CHUYỂN ĐỔI -->
                                <ProgressBar Grid.Column="2" x:Name="PrgConvertLoading" Height="4" IsIndeterminate="True" 
                                             Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Foreground="#D97706" />

                                <TextBlock Grid.Column="3" x:Name="TxtQuickCertNotice" Text="Chứng thư: Hà Văn Tý (Ban Cơ yếu G2)" 
                                           FontSize="11" FontWeight="Medium" Foreground="#059669" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- KHUNG XEM TRƯỚC VÀ CHỈNH SỬA VĂN BẢN TRỰC TIẾP (WEBVIEW2 CANVAS) -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <wv2:WebView2 x:Name="PdfPreviewControl" />
                            
                            <Border x:Name="PnlPreviewPlaceholder" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="56" HorizontalAlignment="Center" Foreground="#94A3B8" />
                                    <TextBlock Text="KHÔNG GIAN HIỂN THỊ &amp; SOẠN THẢO VĂN BẢN TRỰC TIẾP" FontWeight="Bold" FontSize="16" Foreground="#334155" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                    <TextBlock Text="Tải file Word (.docx) hoặc PDF lên. Nội dung sẽ được hiển thị nguyên bản tại đây cho phép bạn đọc, điều chỉnh nội dung trực tiếp trước khi ký." 
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" MaxWidth="600" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- NHẬT KÝ HOẠT ĐỘNG RÚT GỌN -->
                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIẾN TRÌNH: " FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" x:Name="TxtStatusBar" Text="Sẵn sàng." FontSize="11" Foreground="#E2E8F0" FontFamily="Consolas" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: GỬI LÊN WEB ================= -->
            <TabItem Header="  3. Gửi File Lên Cổng Web  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Cấu Hình Gói Tin Đẩy Lên Cổng Web">
                        <StackPanel Margin="6">
                            <TextBlock Text="Tệp PDF đã ký cần gửi:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtUploadFilePath" Background="#F8FAFC" Padding="6" Text="Chưa có file nào sẵn sàng..." />
                                <Button Grid.Column="1" Content="📁 Chọn File..." Style="{StaticResource SecondaryButton}" 
                                        Margin="6,0,0,0" Click="BtnSelectSignedPdfForUpload_Click" />
                            </Grid>

                            <TextBlock Text="Địa chỉ URL Web Gateway tiếp nhận (HTTP/HTTPS):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtUploadUrl" Text="https://httpbin.org/post" Padding="6" Margin="0,0,0,8" />

                            <TextBlock Text="Mã định danh Token / Bearer Key (nếu có):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtAuthToken" Text="Bearer vgca-secure-token-2026" Padding="6" Margin="0,0,0,8" />

                            <TextBlock Text="Tiêu đề văn bản:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtUploadDocTitle" Text="Văn bản đã ký duyệt" Padding="6" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Người ký:" FontSize="11" Foreground="#64748B" />
                                    <TextBox x:Name="TxtUploadSigner" Padding="6" Text="Hà Văn Tý" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Đơn vị / Phòng ban:" FontSize="11" Foreground="#64748B" />
                                    <TextBox x:Name="TxtUploadDepartment" Text="Trường THCS Chu Văn An" Padding="6" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnExecuteUpload" Content="🚀 TIẾN HÀNH GỬI TÀI LIỆU LÊN CỔNG WEB" 
                                    Style="{StaticResource SuccessButton}" 
                                    FontSize="13" Padding="16,10" Margin="0,10,0,0" 
                                    Click="BtnExecuteUpload_Click" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Phản Hồi Mạng Thật Từ Máy Chủ (Live HTTP Response Trace)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Trạng thái HTTP: " FontWeight="Bold" Foreground="#334155" />
                                    <TextBlock x:Name="TxtHttpStatus" Text="Chưa gửi yêu cầu" FontWeight="Bold" Foreground="#64748B" Margin="0,0,20,0" />
                                    <TextBlock Text="Thời gian phản hồi: " FontWeight="Bold" Foreground="#334155" />
                                    <TextBlock x:Name="TxtHttpLatency" Text="0 ms" FontWeight="Bold" Foreground="#0284C7" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                <TextBox x:Name="TxtHttpResponseContent" 
                                         Background="Transparent" Foreground="#38BDF8" 
                                         BorderThickness="0" FontFamily="Consolas" FontSize="11" 
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" 
                                         Text="Chưa có dữ liệu phản hồi từ máy chủ." />
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: KIỂM TRA CHỮ KÝ ================= -->
            <TabItem Header="  4. Kiểm Tra Chữ Ký (Verify)  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Chọn File PDF Cần Kiểm Tra Tính Toàn Vẹn &amp; Pháp Lý">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtVerifyPdfPath" Background="#F8FAFC" Padding="6" Text="Chọn file PDF để kiểm tra..." />
                            <Button Grid.Column="1" Content="🔍 Mở File &amp; Xác Minh" Style="{StaticResource PrimaryButton}" 
                                    Margin="8,0,0,0" Click="BtnVerifyPdf_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Danh Sách Các Chữ Ký Số Phát Hiện Trong Tài Liệu">
                        <ListView x:Name="ListSignatures" Background="White" BorderThickness="0" Margin="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding IsValid}" />
                                    <GridViewColumn Header="Người ký" Width="220" DisplayMemberBinding="{Binding SignerName}" />
                                    <GridViewColumn Header="Ngày ký" Width="150" DisplayMemberBinding="{Binding SignDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Dấu thời gian (TSA)" Width="150" DisplayMemberBinding="{Binding TimestampDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Bảo vệ toàn vẹn" Width="120" DisplayMemberBinding="{Binding CoversWholeDocument}" />
                                    <GridViewColumn Header="Chi tiết chứng thư" Width="400" DisplayMemberBinding="{Binding Details}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="VGCA Sign Tool Pro • Tích hợp Chứng thực số Ban Cơ yếu Chính phủ" FontSize="11" Foreground="#475569" />
                <TextBlock Grid.Column="1" Text="Phiên bản 3.6.0 Pro • .NET 8 x64" FontSize="11" Foreground="#64748B" />
            </Grid>
        </Border>
    </Grid>
</Window>
