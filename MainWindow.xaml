                                                        Padding="8,4" FontSize="11" Click="BtnSyncRosterCloud_Click"
                                                        ToolTip="Tải lại ngay danh bạ và phân quyền đóng dấu mới nhất từ máy chủ đám mây Firebase / Cổng Quản Trị Web" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- KHUNG THÔNG TIN CHI TIẾT CHỨNG THƯ -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- HỌ VÀ TÊN -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Người Ký (Chủ sở hữu):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDetailSignerName" Text="---" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" Margin="0,4" />

                                            <!-- CHỨC VỤ VÀ PHÂN QUYỀN HỆ THỐNG -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chức Vụ &amp; Phân Quyền:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDetailRoleAndSeal" Text="---" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,4" />

                                            <!-- TRẠNG THÁI USB TOKEN / VGCA -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kết Nối Chữ Ký Số:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetailUsbStatus" Text="Đang kiểm tra kết nối..." FontSize="11" FontWeight="SemiBold" Foreground="#D97706" TextWrapping="Wrap" Margin="0,4" />

                                            <!-- EMAIL -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email Công Vụ:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDetailEmail" Text="---" Foreground="#0F172A" Margin="0,4" />

                                            <!-- ĐƠN VỊ -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Đơn Vị Công Tác:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDetailOrg" Text="---" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,4" />

                                            <!-- CƠ QUAN CẤP (CA) -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cơ Quan Cấp Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtDetailIssuer" Text="---" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- SỐ SERIAL -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Số Serial Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDetailSerial" Text="---" FontFamily="Consolas" Foreground="#0F172A" Margin="0,4" />

                                            <!-- HIỆU LỰC -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Thời Hạn Hiệu Lực:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDetailValidity" Text="---" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THUẬT TOÁN KHÓA -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Thuật Toán Mật Mã:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtDetailAlgorithm" Text="---" Foreground="#D97706" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- THUMBPRINT -->
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Mã Băm (Thumbprint):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TxtDetailThumbprint" Text="---" FontFamily="Consolas" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                    </Border>

                                    <!-- NÚT ĐI TỚI SOẠN THẢO (TAB 2) NỔI BẬT -->
                                    <Button Content="👉 Chuyển Sang Soạn Thảo &amp; Ký Số (Tab 2) ➡" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="Bold" Padding="14,10" Click="BtnGoToSignWorkspace_Click" Margin="0,0,0,8" />

                                    <!-- DROPDOWN CHỌN CHỨNG THƯ (CHỈ HIỂN THỊ CHỨNG THƯ HỢP LỆ) -->
                                    <TextBlock Text="Danh sách chứng thư ký số phát hiện trên máy:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbCertificates" Padding="6" SelectionChanged="CmbCertificates_SelectionChanged" />
                                        <Button Grid.Column="1" Content="🔄 Quét Lại Token" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="8,4" Click="BtnRefreshCertificates_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- CỘT PHẢI: MẪU CHỮ KÝ & VỊ TRÍ KÝ MẶC ĐỊNH (SIGNER PROFILE) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Cấu Hình Mẫu Chữ Ký &amp; Vị Trí Mặc Định">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Chọn mẫu chữ ký chuẩn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbProfiles" Padding="6" SelectionChanged="CmbProfiles_SelectionChanged" />
                                        <Button Grid.Column="1" x:Name="BtnAddNewProfile" Content="➕ Thêm Mới" Style="{StaticResource PrimaryButton}" 
                                                Background="#0284C7" BorderBrush="#0369A1" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnAddNewProfile_Click" ToolTip="Tạo thêm mẫu chữ ký mới (ví dụ: Dấu đỏ cơ quan, Ký nháy, Ký duyệt...)" />
                                        <Button Grid.Column="2" x:Name="BtnDeleteProfile" Content="🗑️ Xóa" Style="{StaticResource SecondaryButton}" 
                                                Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnDeleteProfile_Click" ToolTip="Xóa mẫu chữ ký đang chọn" />
                                    </Grid>

                                    <!-- KHUNG CHỌN & XEM TRƯỚC HÌNH ẢNH CON DẤU / CHỮ KÝ TAY -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Hình ảnh con dấu đỏ hoặc chữ ký tay quét:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="🖼 Chọn Ảnh..." Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="BtnSelectStampImage_Click" />
                                                    <Button x:Name="BtnClearStampImage" Content="❌ Gỡ Ảnh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="BtnClearStampImage_Click" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- KHUNG PREVIEW ẢNH CON DẤU THỰC TẾ -->
                                            <Border x:Name="BorderStampPreview" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MinHeight="75" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <!-- PLACEHOLDER KHI CHƯA CHỌN ẢNH -->
                                                    <StackPanel x:Name="PnlStampPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="⭕ Chưa chọn ảnh con dấu / chữ ký tay" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Nhấn nút 'Chọn Ảnh...' ở trên để nạp tệp con dấu đỏ (.png, .jpg)" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- ẢNH HIỂN THỊ THỰC TẾ KHI ĐÃ CHỌN -->
                                                    <StackPanel x:Name="PnlStampLoaded" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Padding="4">
                                                            <Image x:Name="ImgStampPreview" MaxHeight="75" MaxWidth="130" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtStampFileName" Text="quyen.png" FontWeight="Bold" FontSize="12" Foreground="#047857" />
                                                            <TextBlock x:Name="TxtStampDimensionsInfo" Text="Kích thước: 120x120px" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="TxtStampFullPath" Text="C:\...\quyen.png" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="250" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ĐƯỜNG DẪN ẨN / TƯƠNG THÍCH -->
                                            <TextBox x:Name="TxtStampImagePath" Visibility="Collapsed" />

                                            <!-- HÌNH THỨC HIỂN THỊ CHỮ KÝ (MODE) -->
                                            <TextBlock Text="Hình thức thể hiện khi ký trên tài liệu PDF:" FontSize="11" Foreground="#64748B" Margin="0,2,0,2" />
                                            <ComboBox x:Name="CmbDisplayMode" Padding="5" SelectionChanged="CmbDisplayMode_SelectionChanged">
                                                <ComboBoxItem Content="🔴 Chỉ hình ảnh con dấu / chữ ký tay (Khuyên dùng)" IsSelected="True" />
                                                <ComboBoxItem Content="📝 Ảnh con dấu + Dòng thông tin người ký &amp; ngày giờ" />
                                                <ComboBoxItem Content="📄 Chỉ thông tin văn bản chữ ký số điện tử (Không ảnh)" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- VỊ TRÍ KÝ: TRANG, TỌA ĐỘ -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trang ký:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtPageNumber" Text="-1" Padding="4" ToolTip="-1 là trang cuối cùng" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tọa độ X:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordX" Text="380" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tọa độ Y:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordY" Text="120" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Rộng x Cao:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtDimensions" Text="120x120" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Họ tên người ký hiển thị:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSignerDisplayName" Padding="5" Margin="0,0,0,6" />

                                    <TextBlock Text="Lý do ký:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtReason" Text="Ký duyệt phát hành văn bản điện tử" Padding="5" Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkUseTSA" Content="Đóng Dấu thời gian TSA Ban Cơ yếu (http://ca.gov.vn/tsa)" 
                                              IsChecked="True" FontWeight="Normal" FontSize="11" Margin="0,0,0,12" />

                                    <!-- NÚT LƯU CẤU HÌNH & CHUYỂN SANG TAB SOẠN THẢO -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="💾 Lưu Mẫu Chữ Ký" 
                                                Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,4,0" 
                                                Click="BtnSaveProfile_Click" />
                                        <Button Grid.Column="1" Content="👉 Sang Soạn Thảo &amp; Ký Số ➡" 
                                                Style="{StaticResource PrimaryButton}" Padding="10,8" Margin="4,0,0,0" 
                                                Click="BtnGoToSignWorkspace_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: SOẠN THẢO & KÝ SỐ VĂN BẢN TRỰC TIẾP ================= -->
            <TabItem x:Name="TabItemSignWorkspace" Header="  2. ✍️ Soạn Thảo &amp; Ký Số  " IsEnabled="True" FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="GridTab2Root" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- HÀNG 0: THANH CÔNG CỤ ĐIỀU KHIỂN & SOẠN THẢO TRÊN CÙNG -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 1: BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 2: KHUNG HIỂN THỊ TÀI LIỆU TRỰC TIẾP TOÀN MÀN HÌNH -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ ĐIỀU HÀNH VĂN BẢN (TOOLBAR) -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DÒNG 1: TẢI FILE & CÁC NÚT HÀNH ĐỘNG CHÍNH -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- NÚT 1: MỞ FILE WORD -->
                                <Button Grid.Column="0" x:Name="BtnSelectWord" Content="📄 Mở File Word" 
                                        Style="{StaticResource ToolbarWordButton}" 
                                        Click="BtnSelectWord_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở văn bản Microsoft Word (.docx) để xem, chỉnh sửa và ký số" />

                                <!-- NÚT 2: MỞ BẢNG TÍNH EXCEL -->
                                <Button Grid.Column="1" x:Name="BtnSelectExcel" Content="📊 Mở File Excel" 
                                        Style="{StaticResource ToolbarExcelButton}" 
                                        Click="BtnSelectExcel_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở bảng tính Microsoft Excel (.xlsx, .xls) để xem, điều chỉnh và ký số" />

                                <!-- NÚT 3: MỞ FILE PDF TRỰC TIẾP -->
                                <Button Grid.Column="2" x:Name="BtnSelectPdf" Content="📑 Mở File PDF" 
                                        Style="{StaticResource ToolbarPdfButton}" 
                                        Click="BtnSelectPdf_Click" Margin="0,0,10,0" 
                                        ToolTip="Mở trực tiếp tài liệu PDF để ký số điện tử" />

                                <!-- TÊN FILE & TRẠNG THÁI HIỆN TẠI KÈM NÚT ĐÓNG TỆP AN TOÀN -->
                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentFileName" Text="Chưa chọn tệp tin nào." FontWeight="Bold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TxtCurrentFileStatus" Text="Chọn file Word, Excel hoặc PDF để làm việc." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCloseCurrentFile" Content="✕ Đóng Tệp" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2"
                                            Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                            Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="BtnCloseCurrentFile_Click" 
                                            ToolTip="Đóng an toàn tệp đang mở và giải phóng bộ nhớ hệ thống" />
                                </Grid>

                                <!-- NÚT 4: CHUYỂN QUA PDF ĐỂ KÝ -->
                                <Button Grid.Column="4" x:Name="BtnConvertToPdfAndReadySign" 
                                        Content="⚡ Chuyển PDF Để Ký" 
                                        Style="{StaticResource ConvertButton}" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnExecuteConvertDocument_Click" 
                                        ToolTip="Chuyển đổi văn bản sang định dạng chuẩn PDF để sẵn sàng ký số" />

                                <!-- NÚT 5: CHÈN CHỮ KÝ (KÉO THẢ TRỰC TIẾP TRÊN TRANG VĂN BẢN) -->
                                <Button Grid.Column="5" x:Name="BtnInsertSignatureStamp" 
                                        Content="📍 Chèn Vị Trí Ký" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnInsertSignatureStamp_Click" 
                                        ToolTip="Nhấp chuột để chọn vị trí đóng dấu / ký tên trực tiếp trên trang tài liệu" />

                                <!-- NÚT 6: KÝ CÁ NHÂN -->
                                <Button Grid.Column="6" x:Name="BtnSignCurrentDocument" 
                                        Content="✍️ Ký Cá Nhân" 
                                        Style="{StaticResource SignButton}" 
                                        IsEnabled="False" 
                                        Click="BtnSignDocument_Click" 
                                        ToolTip="Thực hiện ký số cá nhân giáo viên chuẩn PAdES theo Nghị định 30/2020/NĐ-CP" />

                                <!-- NÚT 7: ĐÓNG DẤU (USB TOKEN BAN CƠ YẾU) -->
                                <Button Grid.Column="7" x:Name="BtnStampOfficial" 
                                        Content="🔴 Đóng dấu" 
                                        Style="{StaticResource OfficialSealButton}" 
                                        IsEnabled="False" Margin="6,0,0,0"
                                        Click="BtnStampOfficial_Click" 
                                        ToolTip="Đóng dấu pháp nhân trường học bằng USB Token Ban Cơ yếu (Dành cho Ban Giám hiệu / Văn thư)" />
                            </Grid>

                            <!-- DÒNG 2: THANH CÔNG CỤ ĐIỀU CHỈNH VĂN BẢN TRỰC TIẾP (KHI MỞ FILE WORD HOẶC EXCEL) -->
                            <Grid Grid.Row="1" x:Name="PnlEditingToolbar" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtEditorModeBadge" Text="✏ Soạn thảo &amp; Điều chỉnh trực tiếp" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                    <Button Content="B" ToolTip="In đậm (Bold)" Style="{StaticResource FormatButton}" Click="BtnFormatBold_Click" />
                                    <Button Content="I" ToolTip="In nghiêng (Italic)" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="BtnFormatItalic_Click" />
                                    <Button Content="U" ToolTip="Gạch chân (Underline)" Style="{StaticResource FormatButton}" Click="BtnFormatUnderline_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button Content="⇤ Trái" ToolTip="Căn lề trái" Style="{StaticResource FormatButton}" Click="BtnAlignLeft_Click" />
                                    <Button Content="↔ Giữa" ToolTip="Căn giữa" Style="{StaticResource FormatButton}" Click="BtnAlignCenter_Click" />
                                    <Button Content="⇥ Phải" ToolTip="Căn lề phải" Style="{StaticResource FormatButton}" Click="BtnAlignRight_Click" />
                                    <Button Content="⇿ Đều" ToolTip="Căn đều hai bên" Style="{StaticResource FormatButton}" Click="BtnAlignJustify_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button x:Name="BtnSaveWordCopy" Content="💾 Lưu Bản Sao Word..." ToolTip="Lưu nội dung đã chỉnh sửa thành một tệp Word mới (bảo toàn tuyệt đối tệp gốc)" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnSaveWordCopy_Click" />

                                    <!-- NÚT ĐỊNH DẠNG KHỔ IN EXCEL (HIỆN KHI MỞ FILE EXCEL) -->
                                    <StackPanel x:Name="PnlExcelToolbarControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                        <Separator Width="1" Height="16" Margin="0,0,8,0" Background="#CBD5E1" />
                                        <Button Content="📄 Khổ Ngang A4" ToolTip="Định dạng in bảng tính theo khổ ngang A4" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnExcelLandscape_Click" />
                                        <Button Content="📄 Khổ Dọc A4" ToolTip="Định dạng in bảng tính theo khổ dọc A4" Style="{StaticResource FormatButton}" Padding="8,2" Margin="4,0,0,0" Click="BtnExcelPortrait_Click" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- THANH LOADING CHUYỂN ĐỔI -->
                                <ProgressBar Grid.Column="2" x:Name="PrgConvertLoading" Height="4" IsIndeterminate="True" 
                                             Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Foreground="#D97706" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- CHIP HIỂN THỊ ẢNH CON DẤU TRÊN TAB 2 -->
                                    <Border x:Name="BadgeTab2Stamp" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="ImgTab2StampThumb" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="TxtTab2StampStatus" Text="🔴 Con dấu: Chưa chọn" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                            <Button x:Name="BtnTab2SelectStamp" Content="🖼 Đổi mẫu..." Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="6,0,0,0" FontSize="10" Click="BtnTab2ChangeStamp_Click" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtQuickCertNotice" Text="Chưa kết nối chứng thư VGCA" 
                                               FontSize="11" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                    <!-- BANNER KHI ĐANG DUYỆT BÁO CÁO LIÊN THÔNG TỪ HỘP THƯ TAB 3 -->
                    <Border Grid.Row="1" x:Name="BorderWorkflowReviewNotice" Visibility="Collapsed" 
                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtWorkflowReviewNoticeHeader" Text="CHẾ ĐỘ PHÊ DUYỆT BÁO CÁO LIÊN THÔNG (CẤP 2)" 
                                               FontWeight="Bold" Foreground="#1E40AF" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtWorkflowReviewNoticeDetail" Text="Văn bản được tải từ hệ thống trình ký. Vui lòng kiểm tra nội dung và cắm USB Token để ký số phê duyệt." 
                                           FontSize="11" Foreground="#2563EB" Margin="22,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnReturnWorkflowReport" Content="↩️ Trả Về Báo Cáo" Background="#EA580C" Foreground="White" 
                                        FontWeight="Bold" Padding="12,5" FontSize="11" Margin="0,0,8,0" BorderThickness="0"
                                        Cursor="Hand" Click="BtnReturnWorkflowReport_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="✕ Thoát Chế Độ Duyệt" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Click="BtnExitWorkflowReviewMode_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                    <Border Grid.Row="1" x:Name="BorderSignSuccessBanner" Visibility="Collapsed" 
                            Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="VĂN BẢN ĐÃ KÝ SỐ THÀNH CÔNG (CHUẨN PAdES LTV BAN CƠ YẾU CHÍNH PHỦ)" 
                                               FontWeight="Bold" Foreground="#065F46" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtSignedSummaryNotice" Text="Tài liệu đã ký được hiển thị trực tiếp bên dưới để kiểm tra con dấu và nội dung." 
                                           FontSize="11" Foreground="#047857" Margin="22,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Lưu Bản Sao..." Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnSaveSignedCopy_Click" />
                                <Button Content="📂 Mở Tệp Đã Ký" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedPdfExternal_Click" />
                                <Button Content="📁 Mở Thư Mục" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedFolder_Click" />
                                <Button x:Name="BtnSubmitWorkflowReport" Content="📤 Trình Ký Báo Cáo (Tab 3) ➡" Style="{StaticResource SuccessButton}" 
                                        Background="#0D9488" BorderBrush="#0F766E"
                                        Padding="12,5" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Click="BtnSubmitWorkflowReport_Click" />
                                <Button x:Name="BtnCommitWorkflowApproval" Content="✅ Nộp Báo Cáo Đã Duyệt ➡" Style="{StaticResource SuccessButton}" 
                                        Background="#2563EB" BorderBrush="#1D4ED8"
                                        Padding="12,5" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnCommitWorkflowApproval_Click" />
                                <Button x:Name="BtnForwardWorkflowReport" Content="➡ Chuyển Tiếp BGH / Người Duyệt Tiếp" Style="{StaticResource PrimaryButton}" 
                                        Background="#7C3AED" BorderBrush="#6D28D9"
                                        Padding="12,5" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnForwardWorkflowReport_Click" />
                                <Button x:Name="BtnCommitWorkflowSeal" Content="🔴 Nộp Báo Cáo Đã Đóng Dấu ➡" Style="{StaticResource SuccessButton}" 
                                        Background="#DC2626" BorderBrush="#B91C1C"
                                        Padding="12,5" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Click="BtnCommitWorkflowSeal_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KHUNG XEM TRƯỚC VÀ CHỈNH SỬA VĂN BẢN TRỰC TIẾP (WEBVIEW2 CANVAS) -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <!-- 1. WebView2 dành riêng cho PDF (Ký số & con dấu) và bảng tính Excel -->
                            <wv2:WebView2 x:Name="PdfPreviewControl" Visibility="Visible" />

                            <!-- 2. Điều khiển Native A4 Paged Word Editor của Syncfusion (giữ lại để tương thích mã cũ, ẩn hoàn toàn không ảnh hưởng WebView2) -->
                            <syncfusion:SfRichTextBoxAdv x:Name="WordEditorControl" 
                                                         Visibility="Collapsed" 
                                                         Width="0" Height="0"
                                                         LayoutType="Pages"
                                                         Background="#F1F5F9"
                                                         AllowDrop="False" />
                            
                            <Border x:Name="PnlPreviewPlaceholder" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="56" HorizontalAlignment="Center" Foreground="#94A3B8" />
                                    <TextBlock Text="KHÔNG GIAN HIỂN THỊ &amp; SOẠN THẢO VĂN BẢN TRỰC TIẾP" FontWeight="Bold" FontSize="16" Foreground="#334155" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                    <TextBlock Text="Tải file Word (.docx) hoặc PDF lên. Nội dung sẽ được hiển thị nguyên bản tại đây cho phép bạn đọc, điều chỉnh nội dung trực tiếp trước khi ký." 
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" MaxWidth="600" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- OVERLAY KHI CHƯA ĐĂNG NHẬP VGCA (KHÓA TOÀN BỘ TAB 2 KHI CHƯA XÁC THỰC) -->
                    <Border x:Name="OverlayTab2Locked" Grid.RowSpan="3" Background="#F1F5F9" Visibility="Collapsed" Panel.ZIndex="100">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" 
                                MaxWidth="580" MaxHeight="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="CHỨC NĂNG KÝ SỐ ĐANG BỊ TẠM KHÓA" FontWeight="Bold" FontSize="16" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Để đảm bảo an toàn pháp lý và tính toàn vẹn theo quy chuẩn của Ban Cơ yếu Chính phủ, bạn cần đăng nhập tài khoản chữ ký số VGCA Virtual CSP tại Tab 1 trước khi thực hiện soạn thảo và ký số văn bản." 
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#64748B" LineHeight="20" Margin="0,0,0,20" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="🔄 Nhận Diện Chữ Ký Số VGCA (Mở Khóa Ngay)" Style="{StaticResource SuccessButton}" 
                                            FontSize="13" FontWeight="Bold" Padding="16,10" Margin="0,0,10,0" Click="BtnSyncVgcaCertificate_Click" />
                                    <Button Content="🔑 Chuyển Sang Tab 1 Để Đăng Nhập" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="Bold" Padding="16,10" Click="BtnGoToLoginTab_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>


                    <!-- OVERLAY LOADING BACKDROP (LÀM TỐI NỀN WPF KHI POPUP NỔI LÊN) -->
                    <Border x:Name="OverlayLoadingModal" Grid.RowSpan="3" Background="#660F172A" Visibility="Collapsed" Panel.ZIndex="1000" IsHitTestVisible="True" />
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: HỘP THƯ TRÌNH KÝ BÁO CÁO LIÊN THÔNG ================= -->
            <TabItem x:Name="TabItemWorkflow" Header="  3. 📬 Hộp Thư Trình Ký  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- THANH ĐIỀU KHIỂN & CHỈ SỐ NHANH -->
                        <RowDefinition Height="Auto" />
                        <!-- BẢNG ĐIỀU HÀNH & SUB-TABS TRÌNH KÝ -->
                        <RowDefinition Height="*" />
                        <!-- CHÂN TRANG TRẠNG THÁI -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HÀNG 0: THANH ĐIỀU HÀNH NGƯỜI DÙNG & CHỈ SỐ BÁO CÁO -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtWorkflowUserGreeting" Text="Giáo viên: Chưa xác định" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" />
                                            <TextBlock x:Name="TxtWorkflowUserUnit" Text="Trường THCS Chu Văn An" FontSize="11" Foreground="#3B82F6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- THẺ ĐẾM BÁO CÁO CHỜ DUYỆT -->
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥 Chờ tôi duyệt: " FontSize="11" Foreground="#92400E" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCountInbox" Text="0" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- THẺ ĐẾM BÁO CÁO TÔI ĐÃ GỬI -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📤 Tôi đã gửi: " FontSize="11" Foreground="#166534" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCountOutbox" Text="0" FontWeight="Bold" FontSize="13" Foreground="#15803D" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- THẺ ĐẾM BÁO CÁO BỊ TRẢ VỀ -->
                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↩️ Bị trả về: " FontSize="11" Foreground="#C2410C" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCountReturned" Text="0" FontWeight="Bold" FontSize="13" Foreground="#EA580C" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- THẺ ĐẾM BÁO CÁO CHỜ ĐÓNG DẤU (HIỂN THỊ KHI CÓ QUYỀN ĐÓNG DẤU) -->
                                <Border x:Name="BorderWaitingSealCount" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔴 Chờ đóng dấu: " FontSize="11" Foreground="#991B1B" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCountWaitingSeal" Text="0" FontWeight="Bold" FontSize="13" Foreground="#DC2626" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- THẺ ĐẾM TOÀN TRƯỜNG HOÀN TẤT -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 Toàn trường hoàn tất: " FontSize="11" Foreground="#475569" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtCountCompleted" Text="0" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRefreshWorkflow" Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource SecondaryButton}" 
                                        FontSize="12" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" Click="BtnRefreshWorkflow_Click" />
                                <Button Content="➕ Soạn Báo Cáo Mới" Style="{StaticResource PrimaryButton}" 
                                        FontSize="12" FontWeight="Bold" Padding="14,6" Click="BtnNewReportFromTab3_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HÀNG 1: SUB-TABS TRÌNH KÝ (INBOX, OUTBOX, ARCHIVE) -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
                        <TabControl x:Name="TabControlWorkflowSub" Background="Transparent" BorderThickness="0">
                            
                            <!-- SUB-TAB 1: BÁO CÁO CHỜ TÔI DUYỆT (INBOX) -->
                            <TabItem x:Name="TabItemInbox" Header="  📥 Báo Cáo Chờ Tôi Duyệt  " FontSize="13" FontWeight="SemiBold">
                                <Grid Margin="4,8,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- DANH SÁCH BÁO CÁO ĐẾN -->
                                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvInboxReports" BorderThickness="0" Background="Transparent" 
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionMode="Single" MouseDoubleClick="LvInboxReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu Đề Báo Cáo" Width="300" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Người Lập" Width="170" DisplayMemberBinding="{Binding SenderName}" />
                                                    <GridViewColumn Header="Thời Gian Gửi" Width="135" DisplayMemberBinding="{Binding CreatedTimeFormatted}" />
                                                    <GridViewColumn Header="Người Nhận" Width="170" DisplayMemberBinding="{Binding ApproverName}" />
                                                    <GridViewColumn Header="Trạng Thái" Width="155">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Nội Dung H2" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding SignedHashTooltip}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SignedHashDisplay}" Foreground="{Binding SignedHashColor}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>

                                    <!-- THANH THAO TÁC DUYỆT -->
                                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="💡 Gợi ý: Nhấp đúp chuột vào văn bản trong danh sách để mở và ký số ngay." 
                                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BtnOpenForReview" Content="📥 Mở &amp; Ký Duyệt Báo Cáo ➡" 
                                                    Style="{StaticResource PrimaryButton}" 
                                                    FontSize="12" FontWeight="Bold" Padding="16,8" Click="BtnOpenForReview_Click" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 2: BÁO CÁO TÔI ĐÃ GỬI (OUTBOX) -->
                            <TabItem x:Name="TabItemOutbox" Header="  📤 Báo Cáo Tôi ĐÃ Gửi  " FontSize="13" FontWeight="SemiBold">
                                <Grid Margin="4,8,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- DANH SÁCH BÁO CÁO ĐI -->
                                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvOutboxReports" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionChanged="LvOutboxReports_SelectionChanged"
                                                  MouseDoubleClick="LvOutboxReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu Đề Báo Cáo" Width="320" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Thời Gian Gửi" Width="140" DisplayMemberBinding="{Binding CreatedTimeFormatted}" />
                                                    <GridViewColumn Header="Người Nhận" Width="180" DisplayMemberBinding="{Binding ApproverName}" />
