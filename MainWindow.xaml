<Window x:Class="VGCASignToolPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Controls.RichTextBoxAdv;assembly=Syncfusion.SfRichTextBoxAdv.Wpf"
        mc:Ignorable="d"
        Title="VGCA Sign Tool Pro - Hệ thống ký số và soạn thảo văn bản" 
        Icon="app_icon.ico"
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Chính (Xanh dương) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#94A3B8" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Chuyển đổi (Cam / Hổ phách) -->
        <Style x:Key="ConvertButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Ký số Cá nhân (Xanh dương hoàng gia - Primary Action) -->
        <Style x:Key="SignButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Đóng Dấu Pháp Nhân Cơ Quan (Đỏ Quốc Gia Ban Cơ Yếu) -->
        <Style x:Key="OfficialSealButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Word (Xanh dương nhẹ) -->
        <Style x:Key="ToolbarWordButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E40AF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Excel (Xanh lá cây nhẹ) -->
        <Style x:Key="ToolbarExcelButton" TargetType="Button">
            <Setter Property="Background" Value="#F0FDF4" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#15803D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File PDF (Xám thanh lịch) -->
        <Style x:Key="ToolbarPdfButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Thành công (Xanh lá) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10B981" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Phụ (Xám nhạt) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Soạn thảo Mini -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>

        <!-- STYLE TABCONTROL CHUẨN MICROSOFT FLUENT DESIGN (SEGMENTED NAVIGATION BAR) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- THANH ĐIỀU HƯỚNG TABS TÁCH BIỆT (FLUENT SEGMENTED TRACK) -->
                            <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="8" Padding="5" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            
                            <!-- VÙNG NỘI DUNG CHÍNH (CONTENT PRESENTER) -->
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TABITEM CHUẨN MICROSOFT FLUENT DESIGN (HIGH-CONTRAST ACCENT PILL) -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                CornerRadius="6" 
                                Padding="18,8"
                                BorderThickness="0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- KHI DI CHUỘT QUA TAB CHƯA CHỌN (HOVER) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </MultiTrigger>
                            
                            <!-- KHI ĐƯỢC CHỌN (SELECTED - ĐỔI MÀU NỔI BẬT CHUẨN MICROSOFT FLUENT) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            
                            <!-- KHI BỊ KHÓA (DISABLED) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TIÊU ĐỀ CỘT BẢNG (GRIDVIEW COLUMN HEADER) CHUẨN HIỆN ĐẠI -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-2,0" Width="4">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" Width="4" Cursor="SizeWE" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE DÒNG DANH SÁCH (LISTVIEWITEM) CHUẨN MICROSOFT FLUENT UI - CHỐNG NHẤP NHÁY VÀ GIẬT LAG TUYỆT ĐỐI -->
        <Style TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <!-- Lớp 1: Nền dòng độc lập (Background Border) - Thay đổi màu sắc khi Hover/Select hoàn toàn không kích hoạt InvalidateVisual/LayoutPass lên GridViewRowPresenter -->
                            <Border x:Name="ItemRowBackground"
                                    Background="#FFFFFF"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True" />

                            <!-- Lớp 2: Nội dung các cột (GridViewRowPresenter) cố định đệm và không bị re-layout khi đổi màu nền -->
                            <Border Padding="10,6" Background="Transparent" SnapsToDevicePixels="True">
                                <GridViewRowPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>

                            <!-- Lớp 3: Dải định vị Accent mép trái chuẩn Windows 11 Fluent UI -->
                            <Border x:Name="AccentIndicator"
                                    Width="3.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="0,2,2,0"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- KHI RÊ CHUỘT (CHỈ KHI CHƯA CHỌN): NỀN XÁM NHẸ MỊN MÀNG -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemRowBackground" Property="Background" Value="#F8FAFC" />
                            </MultiTrigger>
                            <!-- KHI ĐƯỢC CHỌN (SELECTED): NỀN XANH NHẠT CAO CẤP + THANH ACCENT MẼP TRÁI, CỐ ĐỊNH 1 MÀU DUY NHẤT TRIỆT TIÊU CHỚP MÀU -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRowBackground" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="ItemRowBackground" Property="BorderBrush" Value="#DBEAFE" />
                                <Setter TargetName="AccentIndicator" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <!-- KHI VÔ HIỆU HÓA -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemRowBackground" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VGCA SIGN TOOL PRO" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ký số chuẩn PAdES Ban Cơ yếu Chính phủ • Soạn thảo và xử lý văn bản" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- NÚT KIỂM TRA CẬP NHẬT PHIÊN BẢN MỚI TỪ FIREBASE -->
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" 
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,6" Margin="0,0,10,0" Cursor="Hand" ToolTip="Kiểm tra phiên bản cập nhật mới từ hệ thống (Firebase &amp; GitHub)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11" Margin="0,0,6,0" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtUpdateStatusHeader" Text="Kiểm tra cập nhật" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- BADGE TRẠNG THÁI VGCA TOÀN CỤC -->
                    <Border x:Name="BadgeVgcaGlobalStatus" Background="#B91C1C" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVgcaGlobalStatusIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FEF2F2" />
                            <TextBlock x:Name="TxtVgcaGlobalStatusText" Text="Chưa kết nối chứng thư" 
                                       Foreground="#FEF2F2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14,10,14,10" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ================= TAB 1: THÔNG TIN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <!-- ================= TAB 1: THÔNG TIN NHẬN DIỆN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <TabItem Header="  Nhận diện chữ ký  " FontSize="13" FontWeight="SemiBold">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="520" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: KHUNG THÔNG TIN NHẬN DIỆN CHỨNG THƯ VGCA & PHÂN QUYỀN FIREBASE -->
                        <StackPanel Grid.Column="0">
                            <GroupBox x:Name="GrpVgcaActiveCard" Header="Thông tin nhận diện chữ ký số VGCA Ban Cơ yếu Chính phủ" Visibility="Visible">
                                <StackPanel Margin="4">
                                    <!-- BANNER XÁC THỰC HOẶC CẢNH BÁO TRẠNG THÁI CSP / TOKEN -->
                                    <Border x:Name="BorderDetailBanner" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtDetailBannerIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE730;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#15803D" />
                                                    <TextBlock x:Name="TxtDetailBannerTitle" Text="Đã nhận diện thiết bị ký số Ban Cơ yếu" FontWeight="Bold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtDetailBannerSubtitle" Text="Tự động phân quyền ký số và đóng dấu theo số định danh cá nhân." FontSize="11" Foreground="#166534" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnDetailOpenVcsp" Content="Công cụ VGCA" Style="{StaticResource SecondaryButton}" 
                                                        Background="#FEF3C7" BorderBrush="#FCD34D" Foreground="#B45309" FontWeight="SemiBold" 
                                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnLaunchVgcaManager_Click"
                                                        ToolTip="Mở VGCA Virtual CSP Manager hoặc USB Token Sign Tool">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Mở Virtual CSP Manager (Ký số từ xa)" Click="MenuOpenVcspManager_Click" FontWeight="SemiBold" />
                                                            <Separator />
                                                            <MenuItem Header="Cài đặt VGCA Virtual CSP v2.0" Click="MenuInstallVcsp_Click" />
                                                            <MenuItem Header="Cài đặt VGCA Sign Tool v3.0.6 (USB Token)" Click="MenuInstallVgcaSignTool_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Mở VGCA Sign Tool v3.0.6" Click="MenuOpenVgcaSignTool_Click" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button Content="Quét lại thiết bị" Style="{StaticResource SecondaryButton}" 
                                                        Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155" FontWeight="SemiBold" 
                                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnSyncVgcaCertificate_Click" />
                                                <Button Content="Đồng bộ phân quyền" Style="{StaticResource SecondaryButton}" 
                                                        Background="#ECFDF5" BorderBrush="#A7F3D0" Foreground="#047857" FontWeight="SemiBold" 
                                                        Padding="8,4" FontSize="11" Click="BtnSyncRosterCloud_Click"
                                                        ToolTip="Tải lại danh bạ và quyền đóng dấu từ hệ thống" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- KHUNG THÔNG TIN CHI TIẾT CHỨNG THƯ -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- HỌ VÀ TÊN -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Người ký:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDetailSignerName" Text="---" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" Margin="0,4" />

                                            <!-- CHỨC VỤ -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Chức vụ:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDetailRoleAndSeal" Text="---" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,4" />

                                            <!-- TRẠNG THÁI THIẾT BỊ -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Trạng thái thiết bị:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetailUsbStatus" Text="Đang kiểm tra kết nối..." FontSize="12" FontWeight="SemiBold" Foreground="#D97706" TextWrapping="Wrap" Margin="0,4" />

                                            <!-- EMAIL -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDetailEmail" Text="---" FontSize="12" Foreground="#0F172A" Margin="0,4" />

                                            <!-- ĐƠN VỊ -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Đơn vị:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDetailOrg" Text="---" FontSize="12" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,4" />

                                            <!-- NHÀ CẤP CHỨNG THƯ -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Nhà cấp chứng thư:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtDetailIssuer" Text="---" FontSize="12" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- SỐ SERI -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Số seri:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDetailSerial" Text="---" FontSize="12" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THỜI HẠN -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Thời hạn:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDetailValidity" Text="---" FontSize="12" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THUẬT TOÁN -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Thuật toán:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtDetailAlgorithm" Text="---" FontSize="12" Foreground="#D97706" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- MÃ BĂM -->
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Mã băm:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TxtDetailThumbprint" Text="---" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                    </Border>

                                    <!-- NÚT ĐI TỚI SOẠN THẢO (TAB 2) NỔI BẬT -->
                                    <Button Content="Tiếp tục sang soạn thảo và ký số" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="SemiBold" Padding="14,10" Click="BtnGoToSignWorkspace_Click" Margin="0,0,0,8" />

                                    <!-- DROPDOWN CHỌN CHỨNG THƯ (CHỈ HIỂN THỊ CHỨNG THƯ HỢP LỆ) -->
                                    <TextBlock Text="Danh sách chứng thư ký số phát hiện trên máy:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbCertificates" Padding="6" SelectionChanged="CmbCertificates_SelectionChanged" />
                                        <Button Grid.Column="1" Content="Quét lại" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="8,4" Click="BtnRefreshCertificates_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- CỘT PHẢI: MẪU CHỮ KÝ & VỊ TRÍ KÝ MẶC ĐỊNH (SIGNER PROFILE) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Cấu hình mẫu chữ ký và vị trí mặc định">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Chọn mẫu chữ ký chuẩn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbProfiles" Padding="6" SelectionChanged="CmbProfiles_SelectionChanged" />
                                        <Button Grid.Column="1" x:Name="BtnAddNewProfile" Content="Thêm mới" Style="{StaticResource PrimaryButton}" 
                                                Background="#0284C7" BorderBrush="#0369A1" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnAddNewProfile_Click" ToolTip="Tạo thêm mẫu chữ ký mới" />
                                        <Button Grid.Column="2" x:Name="BtnDeleteProfile" Content="Xóa" Style="{StaticResource SecondaryButton}" 
                                                Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnDeleteProfile_Click" ToolTip="Xóa mẫu chữ ký đang chọn" />
                                    </Grid>

                                    <!-- KHUNG CHỌN & XEM TRƯỚC HÌNH ẢNH CON DẤU / CHỮ KÝ TAY -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Hình ảnh con dấu hoặc chữ ký tay:" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Chọn ảnh..." Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="BtnSelectStampImage_Click" />
                                                    <Button x:Name="BtnClearStampImage" Content="Gỡ ảnh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="BtnClearStampImage_Click" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- KHUNG PREVIEW ẢNH CON DẤU THỰC TẾ -->
                                            <Border x:Name="BorderStampPreview" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MinHeight="75" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <!-- PLACEHOLDER KHI CHƯA CHỌN ẢNH -->
                                                    <StackPanel x:Name="PnlStampPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="Chưa chọn ảnh con dấu hoặc chữ ký tay" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Chọn tệp hình ảnh (.png, .jpg) để hiển thị khi ký" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- ẢNH HIỂN THỊ THỰC TẾ KHI ĐÃ CHỌN -->
                                                    <StackPanel x:Name="PnlStampLoaded" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Padding="4">
                                                            <Image x:Name="ImgStampPreview" MaxHeight="75" MaxWidth="130" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtStampFileName" Text="quyen.png" FontWeight="Bold" FontSize="12" Foreground="#047857" />
                                                            <TextBlock x:Name="TxtStampDimensionsInfo" Text="Kích thước: 120x120px" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="TxtStampFullPath" Text="C:\...\quyen.png" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="250" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ĐƯỜNG DẪN ẨN / TƯƠNG THÍCH -->
                                            <TextBox x:Name="TxtStampImagePath" Visibility="Collapsed" />

                                            <!-- HÌNH THỨC HIỂN THỊ CHỮ KÝ (MODE) -->
                                            <TextBlock Text="Hình thức thể hiện khi ký trên tài liệu PDF:" FontSize="11" Foreground="#64748B" Margin="0,2,0,2" />
                                            <ComboBox x:Name="CmbDisplayMode" Padding="5" SelectionChanged="CmbDisplayMode_SelectionChanged">
                                                <ComboBoxItem Content="Chỉ hình ảnh con dấu hoặc chữ ký tay" IsSelected="True" />
                                                <ComboBoxItem Content="Hình ảnh kèm tên người ký và thời gian" />
                                                <ComboBoxItem Content="Chỉ văn bản chứng thư (không dùng ảnh)" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- VỊ TRÍ KÝ: TRANG, TỌA ĐỘ -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trang ký:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtPageNumber" Text="-1" Padding="4" ToolTip="-1 là trang cuối cùng" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tọa độ X:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordX" Text="380" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tọa độ Y:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordY" Text="120" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Rộng x Cao:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtDimensions" Text="120x120" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Họ tên người ký hiển thị:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSignerDisplayName" Padding="5" Margin="0,0,0,6" />

                                    <TextBlock Text="Lý do ký:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtReason" Text="Ký duyệt phát hành văn bản điện tử" Padding="5" Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkUseTSA" Content="Đóng dấu thời gian TSA Ban Cơ yếu (http://ca.gov.vn/tsa)" 
                                              IsChecked="True" FontWeight="Normal" FontSize="11" Margin="0,0,0,12" />

                                    <!-- NÚT LƯU CẤU HÌNH, ĐỒNG BỘ ĐÁM MÂY & CHUYỂN SANG TAB SOẠN THẢO -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Lưu mẫu ký" 
                                                Style="{StaticResource SecondaryButton}" Padding="8,8" Margin="0,0,3,0" 
                                                Click="BtnSaveProfile_Click" ToolTip="Lưu lại thay đổi mẫu chữ ký hiện tại" />
                                        <Button Grid.Column="1" x:Name="BtnSyncCloudProfile" Content="Đồng bộ đám mây" 
                                                Style="{StaticResource SecondaryButton}" Padding="8,8" Margin="3,0,3,0" 
                                                Background="#F0FDF4" BorderBrush="#BBF7D0" Foreground="#15803D" FontWeight="SemiBold"
                                                Click="BtnSyncCloudProfile_Click" 
                                                ToolTip="Mã hóa AES-256 an toàn và tự động sao lưu hoặc khôi phục mẫu chữ ký từ đám mây Firebase" />
                                        <Button Grid.Column="2" Content="Sang soạn thảo" 
                                                Style="{StaticResource PrimaryButton}" Padding="8,8" Margin="3,0,0,0" 
                                                Click="BtnGoToSignWorkspace_Click" ToolTip="Chuyển sang tab soạn thảo và ký số" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: SOẠN THẢO & KÝ SỐ VĂN BẢN TRỰC TIẾP ================= -->
            <TabItem x:Name="TabItemSignWorkspace" Header="  Soạn thảo và ký số  " IsEnabled="True" FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="GridTab2Root" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- HÀNG 0: THANH CÔNG CỤ ĐIỀU KHIỂN & SOẠN THẢO TRÊN CÙNG -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 1: BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 2: KHUNG HIỂN THỊ TÀI LIỆU TRỰC TIẾP TOÀN MÀN HÌNH -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ ĐIỀU HÀNH VĂN BẢN (TOOLBAR) -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DÒNG 1: TẢI FILE & CÁC NÚT HÀNH ĐỘNG CHÍNH -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- NÚT 1: MỞ FILE WORD -->
                                <Button Grid.Column="0" x:Name="BtnSelectWord" Content="Mở tệp Word" 
                                        Style="{StaticResource ToolbarWordButton}" 
                                        Click="BtnSelectWord_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở tệp Word (.docx) để xem, chỉnh sửa và ký số" />

                                <!-- NÚT 2: MỞ BẢNG TÍNH EXCEL -->
                                <Button Grid.Column="1" x:Name="BtnSelectExcel" Content="Mở tệp Excel" 
                                        Style="{StaticResource ToolbarExcelButton}" 
                                        Click="BtnSelectExcel_Click" Margin="0,0,6,0" 
                                        ToolTip="Mở bảng tính Excel (.xlsx, .xls) để xem và ký số" />

                                <!-- NÚT 3: MỞ FILE PDF TRỰC TIẾP -->
                                <Button Grid.Column="2" x:Name="BtnSelectPdf" Content="Mở tệp PDF" 
                                        Style="{StaticResource ToolbarPdfButton}" 
                                        Click="BtnSelectPdf_Click" Margin="0,0,10,0" 
                                        ToolTip="Mở trực tiếp tài liệu PDF để ký số" />

                                <!-- TÊN FILE & TRẠNG THÁI HIỆN TẠI KÈM NÚT ĐÓNG TỆP AN TOÀN -->
                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentFileName" Text="Chưa chọn tệp tin nào." FontWeight="Bold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TxtCurrentFileStatus" Text="Chọn file Word, Excel hoặc PDF để làm việc." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCloseCurrentFile" Content="Đóng tệp" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2"
                                            Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                            Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="BtnCloseCurrentFile_Click" 
                                            ToolTip="Đóng tệp đang mở" />
                                </Grid>

                                <!-- NÚT 4: CHUYỂN QUA PDF ĐỂ KÝ -->
                                <Button Grid.Column="4" x:Name="BtnConvertToPdfAndReadySign" 
                                        Content="Chuyển sang PDF" 
                                        Style="{StaticResource ConvertButton}" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnExecuteConvertDocument_Click" 
                                        ToolTip="Chuyển đổi văn bản sang định dạng chuẩn PDF để sẵn sàng ký số" />

                                <!-- NÚT 5: CHÈN CHỮ KÝ (KÉO THẢ TRỰC TIẾP TRÊN TRANG VĂN BẢN) -->
                                <Button Grid.Column="5" x:Name="BtnInsertSignatureStamp" 
                                        Content="Đặt vị trí ký" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="SemiBold" 
                                        IsEnabled="False" Margin="0,0,6,0" 
                                        Click="BtnInsertSignatureStamp_Click" 
                                        ToolTip="Chọn vị trí đóng dấu hoặc ký tên trên trang tài liệu" />

                                <!-- NÚT 6: KÝ CÁ NHÂN -->
                                <Button Grid.Column="6" x:Name="BtnSignCurrentDocument" 
                                        Content="Ký cá nhân" 
                                        Style="{StaticResource SignButton}" 
                                        IsEnabled="False" 
                                        Click="BtnSignDocument_Click" 
                                        ToolTip="Thực hiện ký số cá nhân chuẩn PAdES" />

                                <!-- NÚT 7: ĐÓNG DẤU (USB TOKEN BAN CƠ YẾU) -->
                                <Button Grid.Column="7" x:Name="BtnStampOfficial" 
                                        Content="Đóng dấu" 
                                        Style="{StaticResource OfficialSealButton}"
                                        IsEnabled="False" Margin="6,0,0,0"
                                        Click="BtnStampOfficial_Click" 
                                        ToolTip="Đóng dấu pháp nhân trường học bằng USB Token Ban Cơ yếu (Dành cho Ban Giám hiệu / Văn thư)" />
                            </Grid>

                            <!-- DÒNG 2: THANH CÔNG CỤ ĐIỀU CHỈNH VĂN BẢN TRỰC TIẾP (KHI MỞ FILE WORD HOẶC EXCEL) -->
                            <Grid Grid.Row="1" x:Name="PnlEditingToolbar" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtEditorModeBadge" Text="Soạn thảo trực tiếp" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                    <Button Content="B" ToolTip="In đậm (Bold)" Style="{StaticResource FormatButton}" Click="BtnFormatBold_Click" />
                                    <Button Content="I" ToolTip="In nghiêng (Italic)" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="BtnFormatItalic_Click" />
                                    <Button Content="U" ToolTip="Gạch chân (Underline)" Style="{StaticResource FormatButton}" Click="BtnFormatUnderline_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button Content="⇤ Trái" ToolTip="Căn lề trái" Style="{StaticResource FormatButton}" Click="BtnAlignLeft_Click" />
                                    <Button Content="↔ Giữa" ToolTip="Căn giữa" Style="{StaticResource FormatButton}" Click="BtnAlignCenter_Click" />
                                    <Button Content="⇥ Phải" ToolTip="Căn lề phải" Style="{StaticResource FormatButton}" Click="BtnAlignRight_Click" />
                                    <Button Content="⇿ Đều" ToolTip="Căn đều hai bên" Style="{StaticResource FormatButton}" Click="BtnAlignJustify_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button x:Name="BtnSaveWordCopy" Content="Lưu bản sao Word..." ToolTip="Lưu nội dung đã chỉnh sửa thành một tệp Word mới" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnSaveWordCopy_Click" />

                                    <!-- NÚT ĐỊNH DẠNG KHỔ IN EXCEL (HIỆN KHI MỞ FILE EXCEL) -->
                                    <StackPanel x:Name="PnlExcelToolbarControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                        <Separator Width="1" Height="16" Margin="0,0,8,0" Background="#CBD5E1" />
                                        <Button Content="Khổ ngang A4" ToolTip="Định dạng in bảng tính theo khổ ngang A4" Style="{StaticResource FormatButton}" Padding="8,2" Click="BtnExcelLandscape_Click" />
                                        <Button Content="Khổ dọc A4" ToolTip="Định dạng in bảng tính theo khổ dọc A4" Style="{StaticResource FormatButton}" Padding="8,2" Margin="4,0,0,0" Click="BtnExcelPortrait_Click" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- THANH LOADING CHUYỂN ĐỔI -->
                                <ProgressBar Grid.Column="2" x:Name="PrgConvertLoading" Height="4" IsIndeterminate="True" 
                                             Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Foreground="#D97706" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- CHIP HIỂN THỊ ẢNH CON DẤU TRÊN TAB 2 -->
                                    <Border x:Name="BadgeTab2Stamp" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="ImgTab2StampThumb" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="TxtTab2StampStatus" Text="Con dấu: Chưa chọn" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" />
                                            <Button x:Name="BtnTab2SelectStamp" Content="Đổi mẫu..." Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="6,0,0,0" FontSize="10" Click="BtnTab2ChangeStamp_Click" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtQuickCertNotice" Text="Chưa kết nối chứng thư VGCA" 
                                               FontSize="11" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                    <!-- BANNER KHI ĐANG DUYỆT BÁO CÁO LIÊN THÔNG TỪ HỘP THƯ TAB 3 -->
                    <Border Grid.Row="1" x:Name="BorderWorkflowReviewNotice" Visibility="Collapsed" 
                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#1E40AF" />
                                    <TextBlock x:Name="TxtWorkflowReviewNoticeHeader" Text="Chế độ phê duyệt báo cáo liên thông" 
                                               FontWeight="Bold" Foreground="#1E40AF" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtWorkflowReviewNoticeDetail" Text="Văn bản được tải từ hệ thống trình ký. Vui lòng kiểm tra nội dung và ký số phê duyệt." 
                                           FontSize="11" Foreground="#2563EB" Margin="20,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnReturnWorkflowReport" Content="Trả về báo cáo" Background="#EA580C" Foreground="White" 
                                        FontWeight="SemiBold" Padding="12,5" FontSize="11" Margin="0,0,8,0" BorderThickness="0"
                                        Cursor="Hand" Click="BtnReturnWorkflowReport_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Thoát chế độ duyệt" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Click="BtnExitWorkflowReviewMode_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                    <Border Grid.Row="1" x:Name="BorderSignSuccessBanner" Visibility="Collapsed" 
                            Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#065F46" />
                                    <TextBlock Text="Văn bản đã ký số thành công chuẩn PAdES LTV" 
                                               FontWeight="Bold" Foreground="#065F46" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtSignedSummaryNotice" Text="Tài liệu đã ký hiển thị bên dưới để kiểm tra con dấu và nội dung." 
                                           FontSize="11" Foreground="#047857" Margin="20,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Lưu bản sao..." Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnSaveSignedCopy_Click" />
                                <Button Content="Mở tệp đã ký" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedPdfExternal_Click" />
                                <Button Content="Mở thư mục" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedFolder_Click" />
                                <Button x:Name="BtnSubmitWorkflowReport" Content="Trình ký báo cáo" Style="{StaticResource SuccessButton}" 
                                        Background="#0D9488" BorderBrush="#0F766E"
                                        Padding="12,5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnSubmitWorkflowReport_Click" />
                                <Button x:Name="BtnCommitWorkflowApproval" Content="Nộp báo cáo đã duyệt" Style="{StaticResource SuccessButton}" 
                                        Background="#2563EB" BorderBrush="#1D4ED8"
                                        Padding="12,5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnCommitWorkflowApproval_Click" />
                                <Button x:Name="BtnForwardWorkflowReport" Content="Chuyển tiếp người duyệt" Style="{StaticResource PrimaryButton}" 
                                        Background="#7C3AED" BorderBrush="#6D28D9"
                                        Padding="12,5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnForwardWorkflowReport_Click" />
                                <Button x:Name="BtnCommitWorkflowSeal" Content="Nộp báo cáo đã đóng dấu" Style="{StaticResource SuccessButton}" 
                                        Background="#DC2626" BorderBrush="#B91C1C"
                                        Padding="12,5" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" Click="BtnCommitWorkflowSeal_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KHUNG XEM TRƯỚC VÀ CHỈNH SỬA VĂN BẢN TRỰC TIẾP (WEBVIEW2 CANVAS) -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <!-- 1. WebView2 dành riêng cho PDF (Ký số & con dấu) và bảng tính Excel -->
                            <wv2:WebView2 x:Name="PdfPreviewControl" Visibility="Visible" />

                            <!-- 2. Điều khiển Native A4 Paged Word Editor của Syncfusion (giữ lại để tương thích mã cũ, ẩn hoàn toàn không ảnh hưởng WebView2) -->
                            <syncfusion:SfRichTextBoxAdv x:Name="WordEditorControl" 
                                                         Visibility="Collapsed" 
                                                         Width="0" Height="0"
                                                         LayoutType="Pages"
                                                         Background="#F1F5F9"
                                                         AllowDrop="False" />
                            
                            <Border x:Name="PnlPreviewPlaceholder" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="48" HorizontalAlignment="Center" Foreground="#94A3B8" />
                                    <TextBlock Text="Không gian xem và xử lý văn bản" FontWeight="Bold" FontSize="16" Foreground="#334155" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                    <TextBlock Text="Mở tệp Word, Excel hoặc PDF để xem nội dung và thực hiện ký số." 
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" MaxWidth="600" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- OVERLAY KHI CHƯA ĐĂNG NHẬP VGCA (KHÓA TOÀN BỘ TAB 2 KHI CHƯA XÁC THỰC) -->
                    <Border x:Name="OverlayTab2Locked" Grid.RowSpan="3" Background="#F1F5F9" Visibility="Collapsed" Panel.ZIndex="100">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" 
                                MaxWidth="580" MaxHeight="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#64748B" />
                                <TextBlock Text="Chức năng ký số đang khóa" FontWeight="Bold" FontSize="16" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Để đảm bảo tính pháp lý và an toàn dữ liệu, vui lòng cắm USB Token hoặc mở VGCA Virtual CSP để kết nối chữ ký số." 
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#64748B" LineHeight="20" Margin="0,0,0,20" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Nhận diện chữ ký số" Style="{StaticResource SuccessButton}" 
                                            FontSize="13" FontWeight="SemiBold" Padding="16,10" Margin="0,0,10,0" Click="BtnSyncVgcaCertificate_Click" />
                                    <Button Content="Chuyển sang tab nhận diện" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="SemiBold" Padding="16,10" Click="BtnGoToLoginTab_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>


                    <!-- OVERLAY LOADING BACKDROP (LÀM TỐI NỀN WPF KHI POPUP NỔI LÊN) -->
                    <Border x:Name="OverlayLoadingModal" Grid.RowSpan="3" Background="#660F172A" Visibility="Collapsed" Panel.ZIndex="1000" IsHitTestVisible="True" />
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: HỘP THƯ TRÌNH KÝ BÁO CÁO LIÊN THÔNG ================= -->
            <TabItem x:Name="TabItemWorkflow" Header="  Hộp thư trình ký  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- THANH ĐIỀU KHIỂN & CHỈ SỐ NHANH -->
                        <RowDefinition Height="Auto" />
                        <!-- BẢNG ĐIỀU HÀNH & SUB-TABS TRÌNH KÝ -->
                        <RowDefinition Height="*" />
                        <!-- CHÂN TRANG TRẠNG THÁI -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HÀNG 0: THANH ĐIỀU HÀNH NGƯỜI DÙNG & TÁC VỤ TOÀN CỤC -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#1E40AF" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtWorkflowUserGreeting" Text="Giáo viên: Chưa xác định" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" />
                                            <TextBlock x:Name="TxtWorkflowUserUnit" Text="Trường THCS Chu Văn An" FontSize="11" Foreground="#3B82F6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRefreshWorkflow" Content="Làm mới" Style="{StaticResource SecondaryButton}" 
                                        FontSize="12" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" Click="BtnRefreshWorkflow_Click" />
                                <Button Content="Soạn báo cáo mới" Style="{StaticResource SecondaryButton}" 
                                        FontSize="12" FontWeight="SemiBold" Padding="14,6" Click="BtnNewReportFromTab3_Click" 
                                        ToolTip="Chuyển sang tab Soạn thảo để tạo báo cáo mới" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HÀNG 1: SUB-TABS TRÌNH KÝ VỚI COMMAND BAR TÍCH HỢP TRÊN ĐỈNH -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
                        <TabControl x:Name="TabControlWorkflowSub" Background="Transparent" BorderThickness="0">
                            
                            <!-- SUB-TAB 1: BÁO CÁO CHỜ TÔI DUYỆT (INBOX) -->
                            <TabItem x:Name="TabItemInbox">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Chờ tôi duyệt" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Border Background="#FEF3C7" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCountInbox" Text="0" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="4,6,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- COMMAND BAR TRÊN ĐỈNH SUB-TAB 1 -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Nhấp chọn một văn bản trong danh sách hoặc nhấp đúp để ký duyệt ngay." 
                                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BtnOpenForReview" Content="Mở và ký duyệt" 
                                                    Style="{StaticResource PrimaryButton}" 
                                                    IsEnabled="False"
                                                    FontSize="12" FontWeight="SemiBold" Padding="16,6" Click="BtnOpenForReview_Click" 
                                                    ToolTip="Mở văn bản được chọn để đọc và thực hiện ký số phê duyệt" />
                                        </Grid>
                                    </Border>

                                    <!-- DANH SÁCH BÁO CÁO ĐẾN -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvInboxReports" BorderThickness="0" Background="Transparent" 
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionMode="Single"
                                                  SelectionChanged="LvInboxReports_SelectionChanged"
                                                  MouseDoubleClick="LvInboxReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu Đề Báo Cáo" Width="300" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Người Lập" Width="170" DisplayMemberBinding="{Binding SenderName}" />
                                                    <GridViewColumn Header="Thời Gian Gửi" Width="135" DisplayMemberBinding="{Binding CreatedTimeFormatted}" />
                                                    <GridViewColumn Header="Người Nhận" Width="170" DisplayMemberBinding="{Binding ApproverName}" />
                                                    <GridViewColumn Header="Trạng Thái" Width="155">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Nội Dung H2" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding SignedHashTooltip}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SignedHashDisplay}" Foreground="{Binding SignedHashColor}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 2: BÁO CÁO TÔI ĐÃ GỬI (OUTBOX) -->
                            <TabItem x:Name="TabItemOutbox">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tôi đã gửi" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Border Background="#F0FDF4" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCountOutbox" Text="0" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="4,6,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- COMMAND BAR TRÊN ĐỈNH SUB-TAB 2 -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Danh sách các báo cáo bạn đã trình lên cấp trên phê duyệt." 
                                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnViewOutboxReport" Content="Xem lại báo cáo" 
                                                        Style="{StaticResource PrimaryButton}" 
                                                        Background="#4F46E5" BorderBrush="#4338CA"
                                                        FontSize="12" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" 
                                                        IsEnabled="False" Click="BtnViewOutboxReport_Click" />
                                                <Button x:Name="BtnRecallReport" Content="Thu hồi báo cáo" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2"
                                                        FontSize="12" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" 
                                                        IsEnabled="False" Click="BtnRecallReport_Click" />
                                                <Button x:Name="BtnDismissOutboxReport" Content="Xóa khỏi danh sách" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Foreground="#475569" BorderBrush="#CBD5E1" Background="#F1F5F9"
                                                        FontSize="12" FontWeight="SemiBold" Padding="12,6" 
                                                        IsEnabled="False" Click="BtnDismissOutboxReport_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- DANH SÁCH BÁO CÁO ĐI -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvOutboxReports" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionChanged="LvOutboxReports_SelectionChanged"
                                                  MouseDoubleClick="LvOutboxReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mã văn bản" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu đề" Width="320" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Thời gian gửi" Width="140" DisplayMemberBinding="{Binding CreatedTimeFormatted}" />
                                                    <GridViewColumn Header="Người nhận" Width="180" DisplayMemberBinding="{Binding ApproverName}" />
                                                    <GridViewColumn Header="Trạng thái" Width="155">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Nội dung H2" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding SignedHashTooltip}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SignedHashDisplay}" Foreground="{Binding SignedHashColor}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 3: BÁO CÁO TRẢ VỀ (RETURNED) -->
                            <TabItem x:Name="TabItemReturned">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Bị trả về" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Border Background="#FFF7ED" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCountReturned" Text="0" FontSize="11" FontWeight="Bold" Foreground="#EA580C" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="4,6,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- COMMAND BAR TRÊN ĐỈNH SUB-TAB 3 -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Các báo cáo bị trả về cần xem lý do và chỉnh sửa lại." 
                                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnViewReturnedReport" Content="Xem lại báo cáo" 
                                                        Style="{StaticResource PrimaryButton}" 
                                                        Background="#EA580C" BorderBrush="#C2410C"
                                                        FontSize="12" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" 
                                                        IsEnabled="False" Click="BtnViewReturnedReport_Click" />
                                                <Button x:Name="BtnDismissReturnedReport" Content="Xóa khỏi danh sách" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Foreground="#475569" BorderBrush="#CBD5E1" Background="#F1F5F9"
                                                        FontSize="12" FontWeight="SemiBold" Padding="12,6" 
                                                        IsEnabled="False" Click="BtnDismissReturnedReport_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- DANH SÁCH BÁO CÁO TRẢ VỀ -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvReturnedReports" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionChanged="LvReturnedReports_SelectionChanged"
                                                  MouseDoubleClick="LvReturnedReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="TT" Width="45" DisplayMemberBinding="{Binding OrderIndex}" />
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tên Báo Cáo" Width="280" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Thời Gian Trả Về" Width="140" DisplayMemberBinding="{Binding ReturnedTimeFormatted}" />
                                                    <GridViewColumn Header="Người Trả Về" Width="170" DisplayMemberBinding="{Binding ReturnedBy}" />
                                                    <GridViewColumn Header="Lý Do" Width="320">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ReturnReason}" Foreground="#C2410C" FontWeight="SemiBold" 
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ReturnReason}" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 4: BÁO CÁO CHỜ ĐÓNG DẤU (DÀNH CHO BGH / VĂN THƯ GIỮ TOKEN CON DẤU) -->
                            <TabItem x:Name="TabItemWaitingSeal" Visibility="Collapsed">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Chờ đóng dấu" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Border x:Name="BorderWaitingSealCount" Background="#FEF2F2" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCountWaitingSeal" Text="0" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="4,6,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- COMMAND BAR TRÊN ĐỈNH SUB-TAB 4 -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Báo cáo đã ký duyệt 1 cấp, đang chờ cắm USB Token Ban Cơ yếu để đóng con dấu cơ quan." 
                                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BtnOpenForSealing" Content="Mở và đóng dấu" 
                                                    Style="{StaticResource PrimaryButton}" 
                                                    Background="#DC2626" BorderBrush="#B91C1C"
                                                    FontSize="12" FontWeight="SemiBold" Padding="16,6" 
                                                    IsEnabled="False" Click="BtnOpenForSealing_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- DANH SÁCH BÁO CÁO CHỜ ĐÓNG DẤU -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvWaitingSealReports" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionChanged="LvWaitingSealReports_SelectionChanged"
                                                  MouseDoubleClick="LvWaitingSealReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="TT" Width="45" DisplayMemberBinding="{Binding OrderIndex}" />
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu Đề Báo Cáo" Width="280" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Người Lập" Width="160" DisplayMemberBinding="{Binding SenderName}" />
                                                    <GridViewColumn Header="Lãnh Đạo Ký Duyệt" Width="170" DisplayMemberBinding="{Binding ApproverName}" />
                                                    <GridViewColumn Header="Thời Gian Ký" Width="140" DisplayMemberBinding="{Binding SignedTimeFormatted}" />
                                                    <GridViewColumn Header="Trạng Thái" Width="155">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#DC2626" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                    <TextBlock Text="Chờ đóng dấu" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Nội Dung H2" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding SignedHashTooltip}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SignedHashDisplay}" Foreground="#B91C1C" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-TAB 5: KHO BÁO CÁO TOÀN TRƯỜNG ĐÃ HOÀN TẤT (ARCHIVE) -->
                            <TabItem x:Name="TabItemArchive">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Kho lưu trữ" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCountCompleted" Text="0" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="4,6,4,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- COMMAND BAR TRÊN ĐỈNH SUB-TAB 5 -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Các văn bản đã ký đủ 2 cấp và lưu trữ an toàn trong kho toàn trường." 
                                                       FontSize="12" Foreground="#059669" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnViewArchiveReport" Content="Xem tệp đầy đủ" Style="{StaticResource SecondaryButton}" 
                                                        FontSize="12" FontWeight="SemiBold" Padding="14,6" Margin="0,0,6,0" 
                                                        IsEnabled="False" Click="BtnViewArchiveReport_Click" />
                                                <Button x:Name="BtnDownloadArchiveReport" Content="Tải về máy tính" Style="{StaticResource SuccessButton}" 
                                                        FontSize="12" FontWeight="SemiBold" Padding="16,6" 
                                                        IsEnabled="False" Click="BtnDownloadArchiveReport_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- DANH SÁCH BÁO CÁO ĐÃ KÝ 2 CẤP -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                        <ListView x:Name="LvArchiveReports" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Item"
                                                  SelectionChanged="LvArchiveReports_SelectionChanged"
                                                  MouseDoubleClick="LvArchiveReports_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Mã Báo Cáo" Width="155" DisplayMemberBinding="{Binding ReportId}" />
                                                    <GridViewColumn Header="Tiêu Đề Báo Cáo" Width="300" DisplayMemberBinding="{Binding Title}" />
                                                    <GridViewColumn Header="Người Lập" Width="160" DisplayMemberBinding="{Binding SenderName}" />
                                                    <GridViewColumn Header="Thời Gian Gửi" Width="135" DisplayMemberBinding="{Binding CreatedTimeFormatted}" />
                                                    <GridViewColumn Header="Người Phê Duyệt" Width="160" DisplayMemberBinding="{Binding ApproverName}" />
                                                    <GridViewColumn Header="Trạng Thái" Width="145">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#16A34A" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                                    <TextBlock Text="Đã duyệt và ký đủ" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Nội Dung H2" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding SignedHashTooltip}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SignedHashDisplay}" Foreground="#047857" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: KIỂM TRA CHỮ KÝ ================= -->
            <TabItem Header="  Tra cứu và xác thực  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Chọn tệp PDF cần kiểm tra tính toàn vẹn">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtVerifyPdfPath" Background="#F8FAFC" Padding="6" Text="Chọn file PDF để kiểm tra..." />
                            <Button Grid.Column="1" Content="Mở tệp và xác thực" Style="{StaticResource PrimaryButton}" 
                                    Margin="8,0,0,0" Click="BtnVerifyPdf_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Danh sách chữ ký số trong tài liệu">
                        <ListView x:Name="ListSignatures" Background="White" BorderThickness="0" Margin="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding IsValid}" />
                                    <GridViewColumn Header="Người ký" Width="220" DisplayMemberBinding="{Binding SignerName}" />
                                    <GridViewColumn Header="Ngày ký" Width="150" DisplayMemberBinding="{Binding SignDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Dấu thời gian (TSA)" Width="150" DisplayMemberBinding="{Binding TimestampDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Bảo vệ toàn vẹn" Width="120" DisplayMemberBinding="{Binding CoversWholeDocument}" />
                                    <GridViewColumn Header="Chi tiết chứng thư" Width="400" DisplayMemberBinding="{Binding Details}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER STATUS BAR VÀ TIẾN TRÌNH HỆ THỐNG TOÀN CỤC (THAY THẾ HÌNH 2 BẰNG HÌNH 1 VÀ BỔ SUNG PHIÊN BẢN GÓC PHẢI) -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIẾN TRÌNH: " FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" x:Name="TxtStatusBar" Text="Sẵn sàng." FontSize="11" Foreground="#E2E8F0" FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" x:Name="TxtAppVersion" Text="Phiên bản v2.5.3 • .NET 8 x64" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- POPUP LOADING MODAL TRUNG TÂM (KHẮC PHỤC TRIỆT ĐỂ AIRSPACE CỦA WEBVIEW2) -->
        <Popup x:Name="OverlayLoadingPopup" 
               IsOpen="False" 
               Placement="Center" 
               PlacementTarget="{Binding ElementName=MainRootGrid}" 
               AllowsTransparency="True" 
               PopupAnimation="None" 
               StaysOpen="True">
            <Grid Margin="24">
                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="16" 
                        Width="420" Padding="32,28">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- HUY HIỆU ICON CHỮ KÝ / TỆP TIN TĨNH -->
                        <Border Width="64" Height="64" CornerRadius="32" 
                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="2" 
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtPopupLoadingIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" FontSize="28" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" />
                        </Border>

                        <!-- TIÊU ĐỀ THAO TÁC -->
                        <TextBlock x:Name="TxtPopupLoadingTitle" Text="Đang xử lý, vui lòng chờ..." 
                                   FontWeight="Bold" FontSize="16" Foreground="#1E293B" 
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6" />

                        <!-- MÔ TẢ CHI TIẾT -->
                        <TextBlock x:Name="TxtPopupLoadingMessage" Text="Hệ thống đang xử lý và dựng trang, vui lòng chờ trong giây lát..." 
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" 
                                   HorizontalAlignment="Center" TextAlignment="Center" LineHeight="19" Margin="0,0,0,18" MaxWidth="360" />

                        <!-- THANH TIẾN TRÌNH LƯỚT SÓNG FLUENT (INDETERMINATE) SIÊU NHẸ 0% CPU -->
                        <Border Width="320" Height="4" Background="#E2E8F0" CornerRadius="2" Margin="0,0,0,14" SnapsToDevicePixels="True">
                            <ProgressBar Height="4" Width="320" IsIndeterminate="True" 
                                         Foreground="#2563EB" Background="Transparent" BorderThickness="0" />
                        </Border>

                        <!-- HUY HIỆU BẢO MẬT & TIÊU CHUẨN KÝ SỐ -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,5" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="11" Foreground="#0D9488" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Bảo vệ toàn vẹn tài liệu và chứng thư số" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- NÚT HỦY KÝ / HỦY CHỜ THAO TÁC -->
                        <Button x:Name="BtnCancelSigningOverlay" 
                                Content="Hủy chờ ký" 
                                Style="{StaticResource SecondaryButton}" 
                                Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2"
                                FontSize="12" FontWeight="SemiBold" 
                                Padding="16,6" Margin="0,14,0,0" 
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="BtnCancelSigningOverlay_Click" 
                                ToolTip="Hủy bỏ phiên chờ ký số hiện tại và quay lại màn hình làm việc" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- POPUP TRÌNH KÝ BÁO CÁO LIÊN THÔNG -->
        <Popup x:Name="OverlaySubmitWorkflowPopup" 
               IsOpen="False" 
               Placement="Center" 
               PlacementTarget="{Binding ElementName=MainRootGrid}" 
               AllowsTransparency="True" 
               PopupAnimation="None" 
               StaysOpen="True" 
               Focusable="True">
            <Grid Margin="24">
                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="14" 
                        MaxWidth="620" Width="600" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#CCFBF1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" FontSize="22" Foreground="#0D9488" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Trình ký báo cáo liên thông" FontWeight="Bold" FontSize="16" Foreground="#0F766E" />
                                <TextBlock Text="Gửi báo cáo lên hệ thống để cấp trên phê duyệt" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Tiêu đề báo cáo:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtWorkflowSubmitTitle" Padding="8,6" FontSize="13" Margin="0,0,0,12" Background="#F8FAFC" />

                        <TextBlock Text="Người lập báo cáo:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtWorkflowSubmitSender" Text="Giáo viên (Đang đăng nhập)" FontSize="12" Foreground="#1E293B" FontWeight="Medium" />
                        </Border>

                        <TextBlock Text="Chọn Người nhận phê duyệt (Tổ trưởng / Ban Giám hiệu):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <ComboBox x:Name="CboWorkflowApprover" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

                        <TextBlock Text="Ghi chú kèm theo (tùy chọn):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtWorkflowSubmitNotes" Padding="8,6" FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Background="#F8FAFC" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" 
                                    Padding="16,8" FontSize="13" Margin="0,0,10,0" Click="BtnCancelSubmitWorkflow_Click" />
                            <Button x:Name="BtnConfirmSubmitWorkflow" Content="Xác nhận gửi trình ký" Style="{StaticResource SuccessButton}" 
                                    Background="#0D9488" BorderBrush="#0F766E"
                                    Padding="20,8" FontSize="13" FontWeight="SemiBold" Click="BtnConfirmSubmitWorkflow_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- POPUP LỰA CHỌN PHÊ DUYỆT HOÀN TẤT HOẶC CHUYỂN TIẾP CHO BGH -->
        <Popup x:Name="OverlayApprovalChoicePopup" 
               IsOpen="False" 
               Placement="Center" 
               PlacementTarget="{Binding ElementName=MainRootGrid}" 
               AllowsTransparency="True" 
               PopupAnimation="None" 
               StaysOpen="True" 
               Focusable="True">
            <Grid Margin="24">
                <Border Background="White" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="14" 
                        MaxWidth="640" Width="620" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="22" Foreground="#1D4ED8" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ký số phê duyệt thành công" FontWeight="Bold" FontSize="17" Foreground="#1D4ED8" />
                                <TextBlock Text="Văn bản đã được nhúng chữ ký số và tem thời gian TSA Ban Cơ yếu" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Vui lòng chọn bước xử lý tiếp theo cho báo cáo này:" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,14" />

                        <!-- OPTION 1: HOÀN TẤT -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="ChoiceCommitApproval_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="20" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="1. Phê duyệt hoàn tất và lưu trữ chung" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                    <TextBlock Text="Áp dụng khi bạn là người ký cuối cùng (văn bản cấp tổ, nội bộ hoặc BGH)." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Chọn" Style="{StaticResource SuccessButton}" Background="#059669" BorderBrush="#047857" FontSize="11" FontWeight="SemiBold" Padding="12,5" Click="ChoiceCommitApproval_Click" />
                            </Grid>
                        </Border>

                        <!-- OPTION 2: CHUYỂN TIẾP -->
                        <Border Background="#FAF5FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonUp="ChoiceForwardApproval_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" FontSize="20" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="2. Chuyển tiếp cho Ban Giám hiệu / Người duyệt tiếp theo" FontWeight="Bold" FontSize="13" Foreground="#6D28D9" />
                                    <TextBlock Text="Áp dụng khi Tổ trưởng duyệt xong cần trình lên BGH phê duyệt và đóng dấu." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Chọn" Style="{StaticResource PrimaryButton}" Background="#7C3AED" BorderBrush="#6D28D9" FontSize="11" FontWeight="SemiBold" Padding="12,5" Click="ChoiceForwardApproval_Click" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Xem lại bản đã ký" Style="{StaticResource SecondaryButton}" 
                                    Padding="14,7" FontSize="12" Click="BtnCloseApprovalChoice_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- POPUP CHUYỂN TIẾP BÁO CÁO CHO BGH / NGƯỜI DUYỆT TIẾP THEO -->
        <Popup x:Name="OverlayForwardWorkflowPopup" 
               IsOpen="False" 
               Placement="Center" 
               PlacementTarget="{Binding ElementName=MainRootGrid}" 
               AllowsTransparency="True" 
               PopupAnimation="None" 
               StaysOpen="True" 
               Focusable="True">
            <Grid Margin="24">
                <Border Background="White" BorderBrush="#7C3AED" BorderThickness="2" CornerRadius="14" 
                        MaxWidth="620" Width="600" Padding="28">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#F3E8FF" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" FontSize="22" Foreground="#7C3AED" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Chuyển tiếp báo cáo lên cấp trên" FontWeight="Bold" FontSize="16" Foreground="#6D28D9" />
                                <TextBlock Text="Trình văn bản đã ký duyệt lên Ban Giám hiệu hoặc người duyệt tiếp theo" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Tiêu đề báo cáo:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtForwardReportTitle" Text="---" FontSize="12" Foreground="#1E293B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>

                        <TextBlock Text="Người đã ký duyệt:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtForwardCurrentSigner" Text="---" FontSize="12" Foreground="#1E293B" FontWeight="Medium" />
                        </Border>

                        <TextBlock Text="Chọn Người duyệt tiếp theo (Ban Giám Hiệu / Lãnh đạo):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <ComboBox x:Name="CboForwardNextApprover" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

                        <TextBlock Text="Ý kiến chuyên môn / Ghi chú chuyển tiếp:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtForwardNotes" Padding="8,6" FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Background="#F8FAFC" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy bỏ" Style="{StaticResource SecondaryButton}" 
                                    Padding="16,8" FontSize="13" Margin="0,0,10,0" Click="BtnCancelForwardWorkflow_Click" />
                            <Button x:Name="BtnConfirmForwardWorkflow" Content="Xác nhận chuyển tiếp" Style="{StaticResource PrimaryButton}" 
                                    Background="#7C3AED" BorderBrush="#6D28D9"
                                    Padding="20,8" FontSize="13" FontWeight="SemiBold" Click="BtnConfirmForwardWorkflow_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
