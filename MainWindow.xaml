                                            <!-- ĐƠN VỊ -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Đơn Vị Công Tác:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDetailOrg" Text="TRƯỜNG THCS CHU VĂN AN - UBND XÃ ĐẮK HÀ - TỈNH QUẢNG NGÃI" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,4" />

                                            <!-- CƠ QUAN CẤP (CA) -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cơ Quan Cấp Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtDetailIssuer" Text="CA phục vụ các cơ quan Nhà nước G2, Ban Cơ yếu Chính phủ" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- SỐ SERIAL -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Số Serial Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDetailSerial" Text="7C4C44A8671300AE" FontFamily="Consolas" Foreground="#0F172A" Margin="0,4" />

                                            <!-- HIỆU LỰC -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Thời Hạn Hiệu Lực:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDetailValidity" Text="29/05/2026 đến 28/05/2031 (Đang hoạt động)" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THUẬT TOÁN KHÓA -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Thuật Toán Mật Mã:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtDetailAlgorithm" Text="ECDSA 384-bit (ECC Curve P-384 / KSP)" Foreground="#D97706" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- THUMBPRINT -->
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Mã Băm (Thumbprint):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TxtDetailThumbprint" Text="6398E3DC37E44EBBF976DFDE9F0143E1BDA5346D" FontFamily="Consolas" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                    </Border>

                                    <!-- NÚT ĐI TỚI SOẠN THẢO (TAB 2) NỔI BẬT -->
                                    <Button Content="👉 Chuyển Sang Soạn Thảo &amp; Ký Số (Tab 2) ➡" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="Bold" Padding="14,10" Click="BtnGoToSignWorkspace_Click" Margin="0,0,0,8" />

                                    <!-- DROPDOWN CHỌN CHỨNG THƯ (CHỈ HIỂN THỊ CHỨNG THƯ HỢP LỆ) -->
                                    <TextBlock Text="Danh sách chứng thư ký số phát hiện trên máy:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbCertificates" Padding="6" SelectionChanged="CmbCertificates_SelectionChanged" />
                                        <Button Grid.Column="1" Content="🔄 Quét Lại Token" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="8,4" Click="BtnRefreshCertificates_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- CỘT PHẢI: MẪU CHỮ KÝ & VỊ TRÍ KÝ MẶC ĐỊNH (SIGNER PROFILE) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Cấu Hình Mẫu Chữ Ký &amp; Vị Trí Mặc Định">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Chọn mẫu chữ ký chuẩn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbProfiles" Padding="6" SelectionChanged="CmbProfiles_SelectionChanged" />
                                        <Button Grid.Column="1" x:Name="BtnAddNewProfile" Content="➕ Thêm Mới" Style="{StaticResource PrimaryButton}" 
                                                Background="#0284C7" BorderBrush="#0369A1" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnAddNewProfile_Click" ToolTip="Tạo thêm mẫu chữ ký mới (ví dụ: Dấu đỏ cơ quan, Ký nháy, Ký duyệt...)" />
                                        <Button Grid.Column="2" x:Name="BtnDeleteProfile" Content="🗑️ Xóa" Style="{StaticResource SecondaryButton}" 
                                                Foreground="#DC2626" BorderBrush="#FCA5A5" Background="#FEF2F2" Padding="8,4" FontSize="11" Margin="6,0,0,0" 
                                                Click="BtnDeleteProfile_Click" ToolTip="Xóa mẫu chữ ký đang chọn" />
                                    </Grid>

                                    <!-- KHUNG CHỌN & XEM TRƯỚC HÌNH ẢNH CON DẤU / CHỮ KÝ TAY -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Hình ảnh con dấu đỏ hoặc chữ ký tay quét:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="🖼 Chọn Ảnh..." Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="BtnSelectStampImage_Click" />
                                                    <Button x:Name="BtnClearStampImage" Content="❌ Gỡ Ảnh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="BtnClearStampImage_Click" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- KHUNG PREVIEW ẢNH CON DẤU THỰC TẾ -->
                                            <Border x:Name="BorderStampPreview" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MinHeight="75" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <!-- PLACEHOLDER KHI CHƯA CHỌN ẢNH -->
                                                    <StackPanel x:Name="PnlStampPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="⭕ Chưa chọn ảnh con dấu / chữ ký tay" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Nhấn nút 'Chọn Ảnh...' ở trên để nạp tệp con dấu đỏ (.png, .jpg)" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- ẢNH HIỂN THỊ THỰC TẾ KHI ĐÃ CHỌN -->
                                                    <StackPanel x:Name="PnlStampLoaded" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Padding="4">
                                                            <Image x:Name="ImgStampPreview" MaxHeight="75" MaxWidth="130" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtStampFileName" Text="quyen.png" FontWeight="Bold" FontSize="12" Foreground="#047857" />
                                                            <TextBlock x:Name="TxtStampDimensionsInfo" Text="Kích thước: 120x120px" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="TxtStampFullPath" Text="C:\...\quyen.png" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="250" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ĐƯỜNG DẪN ẨN / TƯƠNG THÍCH -->
                                            <TextBox x:Name="TxtStampImagePath" Visibility="Collapsed" />

                                            <!-- HÌNH THỨC HIỂN THỊ CHỮ KÝ (MODE) -->
                                            <TextBlock Text="Hình thức thể hiện khi ký trên tài liệu PDF:" FontSize="11" Foreground="#64748B" Margin="0,2,0,2" />
                                            <ComboBox x:Name="CmbDisplayMode" Padding="5" SelectionChanged="CmbDisplayMode_SelectionChanged">
                                                <ComboBoxItem Content="🔴 Chỉ hình ảnh con dấu / chữ ký tay (Khuyên dùng)" IsSelected="True" />
                                                <ComboBoxItem Content="📝 Ảnh con dấu + Dòng thông tin người ký &amp; ngày giờ" />
                                                <ComboBoxItem Content="📄 Chỉ thông tin văn bản chữ ký số điện tử (Không ảnh)" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- VỊ TRÍ KÝ: TRANG, TỌA ĐỘ -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trang ký:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtPageNumber" Text="-1" Padding="4" ToolTip="-1 là trang cuối cùng" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tọa độ X:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordX" Text="380" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tọa độ Y:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordY" Text="120" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Rộng x Cao:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtDimensions" Text="120x120" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Họ tên người ký hiển thị:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSignerDisplayName" Padding="5" Margin="0,0,0,6" />

                                    <TextBlock Text="Lý do ký:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtReason" Text="Ký duyệt phát hành văn bản điện tử" Padding="5" Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkUseTSA" Content="Đóng Dấu thời gian TSA Ban Cơ yếu (http://ca.gov.vn/tsa)" 
                                              IsChecked="True" FontWeight="Normal" FontSize="11" Margin="0,0,0,12" />

                                    <!-- NÚT LƯU CẤU HÌNH & CHUYỂN SANG TAB SOẠN THẢO -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
