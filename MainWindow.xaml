<Window x:Class="VGCASignToolPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="VGCA Sign Tool Pro - Hệ Thống Ký Số Điện Tử &amp; Soạn Thảo Văn Bản Tích Hợp" 
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Chính (Xanh dương) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#94A3B8" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Chuyển đổi (Cam / Hổ phách) -->
        <Style x:Key="ConvertButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Ký số (Đỏ Ban Cơ yếu) -->
        <Style x:Key="SignButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Thành công (Xanh lá) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10B981" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Phụ (Xám nhạt) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Soạn thảo Mini -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VGCA SIGN TOOL PRO" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ký số PAdES Ban Cơ yếu Chính phủ • Soạn thảo &amp; Xem trực tiếp Word/PDF • Cổng Web" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BADGE TRẠNG THÁI VGCA TOÀN CỤC -->
                    <Border x:Name="BadgeVgcaGlobalStatus" Background="#065F46" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVgcaGlobalStatusIcon" Text="✅" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtVgcaGlobalStatusText" Text="VGCA Virtual CSP: Đã Đăng Nhập" 
                                       Foreground="#ECFDF5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14,10,14,10" Background="Transparent" BorderThickness="0">

            <!-- ================= TAB 1: THÔNG TIN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <TabItem Header="  1. Thông Tin Chữ Ký Số (VGCA)  " FontSize="14" FontWeight="SemiBold">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="520" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: KHUNG ĐĂNG NHẬP VGCA VIRTUAL CSP & THÔNG TIN CHỨNG THƯ -->
                        <StackPanel Grid.Column="0">
                            <!-- PANEL 1: KHI CHƯA ĐĂNG NHẬP - GIAO DIỆN TÍCH HỢP VGCA VIRTUAL CSP v2.0 -->
                            <GroupBox x:Name="GrpVgcaLoginBox" Header="Đăng Nhập VGCA Virtual CSP v2.0 (Ban Cơ Yếu Chính Phủ)">
                                <StackPanel Margin="6">
                                    <!-- HEADER GIỚI THIỆU CHUẨN VGCA -->
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="CỔNG XÁC THỰC CHỮ KÝ SỐ CHUYÊN DÙNG CHÍNH PHỦ" FontWeight="Bold" Foreground="#1E3A8A" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Tích hợp trực tiếp chuẩn xác thực VGCA Virtual CSP v2.0. Đăng nhập để kích hoạt quyền truy cập cặp khóa mật mã ký số và mở khóa khu vực Soạn thảo - Ký số." 
                                                       TextWrapping="Wrap" FontSize="11" Foreground="#1E40AF" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- HÌNH THỨC ĐĂNG NHẬP (TAB CONTROL PHỤ) -->
                                    <TabControl x:Name="TabLoginMethods" Margin="0,0,0,12" Background="White" BorderBrush="#CBD5E1">
                                        <!-- PHƯƠNG THỨC 1: TÀI KHOẢN & MẬT KHẨU -->
                                        <TabItem Header="  🔑 Tài Khoản (CCCD) &amp; Mật Khẩu  " FontWeight="SemiBold" FontSize="12">
                                            <StackPanel Margin="10,12,10,6">
                                                <!-- CHỌN NHANH DANH SÁCH GIÁO VIÊN ĐÃ CẤP CHỨNG THƯ -->
                                                <TextBlock Text="Chọn nhanh cán bộ / giáo viên trong danh bạ đơn vị:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                <ComboBox x:Name="CmbRosterQuickSelect" Padding="6" Margin="0,0,0,10" SelectionChanged="CmbRosterQuickSelect_SelectionChanged" />

                                                <!-- NHẬP CCCD -->
                                                <TextBlock Text="Số Căn cước công dân (12 chữ số):" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                <TextBox x:Name="TxtVgcaCccd" Text="042084002100" Padding="8,6" Margin="0,0,0,10" FontFamily="Consolas" FontSize="13" />

                                                <!-- NHẬP MẬT KHẨU -->
                                                <TextBlock Text="Mật khẩu tài khoản VGCA Virtual CSP:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                <PasswordBox x:Name="TxtVgcaPassword" Password="Password123!" Padding="8,6" Margin="0,0,0,10" FontSize="13" />

                                                <!-- CHECKBOX GHI NHỚ -->
                                                <CheckBox x:Name="ChkVgcaRemember" Content="Ghi nhớ phiên đăng nhập trên máy tính này" IsChecked="True" FontSize="11" Margin="0,0,0,12" />

                                                <!-- NÚT ĐĂNG NHẬP -->
                                                <Button x:Name="BtnVgcaLogin" Content="🔑 ĐĂNG NHẬP VGCA VIRTUAL CSP" Style="{StaticResource PrimaryButton}" 
                                                        Background="#1E40AF" FontSize="13" Padding="14,10" Click="BtnVgcaLogin_Click" />
                                            </StackPanel>
                                        </TabItem>

                                        <!-- PHƯƠNG THỨC 2: QUÉT MÃ QR CODE -->
                                        <TabItem Header="  📱 Quét Mã QR Code  " FontWeight="SemiBold" FontSize="12">
                                            <StackPanel Margin="10,12,10,6" HorizontalAlignment="Center">
                                                <TextBlock Text="Quét mã QR bằng ứng dụng VGCA Mobile trên điện thoại:" FontSize="11" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                
                                                <!-- KHUNG HIỂN THỊ MÃ QR -->
                                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Background="White" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <Image x:Name="ImgVgcaQrCode" Width="170" Height="170" Stretch="Uniform" />
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Button Content="🔄 Tạo Mã QR Mới" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Click="BtnRefreshQr_Click" Margin="0,0,8,0" />
                                                    <Button Content="📱 Phê Duyệt Quét Mã (Mô phỏng)" Style="{StaticResource SuccessButton}" Padding="10,5" FontSize="11" Click="BtnApproveQr_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>

                                    <!-- KHUNG THÔNG BÁO LỖI ĐĂNG NHẬP -->
                                    <Border x:Name="BorderVgcaAuthError" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="❌" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtVgcaAuthError" Text="Lỗi đăng nhập..." Foreground="#991B1B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- TÙY CHỌN DỰ PHÒNG: MỞ APP NGOÀI NẾU CẦN -->
                                    <Button Content="🖥️ Mở Ứng Dụng VGCA Virtual CSP Bên Ngoài" Style="{StaticResource SecondaryButton}" 
                                            Padding="10,6" FontSize="11" Click="BtnLaunchVgcaManager_Click" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>

                            <!-- PANEL 2: KHI ĐÃ ĐĂNG NHẬP THÀNH CÔNG - THẺ CHỨNG THƯ HOẠT ĐỘNG -->
                            <GroupBox x:Name="GrpVgcaActiveCard" Header="Tài Khoản Ký Số Đang Hoạt Động (Ban Cơ Yếu Chính Phủ)" Visibility="Collapsed">
                                <StackPanel Margin="4">
                                    <!-- BANNER XÁC THỰC THÀNH CÔNG -->
                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛡️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="PHIÊN ĐĂNG NHẬP VGCA ĐÃ XÁC THỰC" FontWeight="Bold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Đã sẵn sàng ký số tài liệu chuẩn PAdES LTV theo Nghị định 30/2020/NĐ-CP." FontSize="11" Foreground="#166534" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🚪 Đăng Xuất" Style="{StaticResource SecondaryButton}" 
                                                    Background="#FEE2E2" BorderBrush="#FCA5A5" Foreground="#991B1B" FontWeight="Bold" 
                                                    Padding="10,4" FontSize="11" VerticalAlignment="Center" Click="BtnVgcaLogout_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- KHUNG THÔNG TIN CHI TIẾT CHỨNG THƯ -->
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- HỌ VÀ TÊN -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Người Ký (Chủ sở hữu):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDetailSignerName" Text="Hà Văn Tý" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" Margin="0,4" />

                                            <!-- EMAIL -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email Công Vụ:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDetailEmail" Text="hvty-dakha@quangngai.gov.vn" Foreground="#0F172A" Margin="0,4" />

                                            <!-- ĐƠN VỊ -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Đơn Vị Công Tác:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetailOrg" Text="TRƯỜNG THCS CHU VĂN AN - UBND XÃ ĐẮK HÀ - TỈNH QUẢNG NGÃI" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,4" />

                                            <!-- CƠ QUAN CẤP (CA) -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cơ Quan Cấp Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDetailIssuer" Text="CA phục vụ các cơ quan Nhà nước G2, Ban Cơ yếu Chính phủ" Foreground="#059669" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- SỐ SERIAL -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Số Serial Chứng Thư:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtDetailSerial" Text="7C4C44A8671300AE" FontFamily="Consolas" Foreground="#0F172A" Margin="0,4" />

                                            <!-- HIỆU LỰC -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Thời Hạn Hiệu Lực:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtDetailValidity" Text="29/05/2026 đến 28/05/2031 (Đang hoạt động)" Foreground="#0F172A" Margin="0,4" />

                                            <!-- THUẬT TOÁN KHÓA -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Thuật Toán Mật Mã:" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDetailAlgorithm" Text="ECDSA 384-bit (ECC Curve P-384 / KSP)" Foreground="#D97706" FontWeight="SemiBold" Margin="0,4" />

                                            <!-- THUMBPRINT -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Mã Băm (Thumbprint):" FontWeight="Bold" Foreground="#475569" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDetailThumbprint" Text="6398E3DC37E44EBBF976DFDE9F0143E1BDA5346D" FontFamily="Consolas" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                    </Border>

                                    <!-- NÚT ĐI TỚI SOẠN THẢO (TAB 2) NỔI BẬT -->
                                    <Button Content="👉 Chuyển Sang Soạn Thảo &amp; Ký Số (Tab 2) ➡" Style="{StaticResource PrimaryButton}" 
                                            Background="#1E40AF" FontSize="13" FontWeight="Bold" Padding="14,10" Click="BtnGoToSignWorkspace_Click" Margin="0,0,0,8" />

                                    <!-- DROPDOWN CHỌN CHỨNG THƯ (CHỈ HIỂN THỊ CHỨNG THƯ HỢP LỆ) -->
                                    <TextBlock Text="Danh sách chứng thư ký số phát hiện trên máy:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CmbCertificates" Padding="6" SelectionChanged="CmbCertificates_SelectionChanged" />
                                        <Button Grid.Column="1" Content="🔄 Quét Lại Token" Style="{StaticResource SecondaryButton}" 
                                                Margin="6,0,0,0" Padding="8,4" Click="BtnRefreshCertificates_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- CỘT PHẢI: MẪU CHỮ KÝ & VỊ TRÍ KÝ MẶC ĐỊNH (SIGNER PROFILE) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Cấu Hình Mẫu Chữ Ký &amp; Vị Trí Mặc Định">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Chọn mẫu chữ ký chuẩn:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CmbProfiles" Margin="0,0,0,8" Padding="6" SelectionChanged="CmbProfiles_SelectionChanged" />

                                    <!-- KHUNG CHỌN & XEM TRƯỚC HÌNH ẢNH CON DẤU / CHỮ KÝ TAY -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Hình ảnh con dấu đỏ hoặc chữ ký tay quét:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="🖼 Chọn Ảnh..." Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Click="BtnSelectStampImage_Click" />
                                                    <Button x:Name="BtnClearStampImage" Content="❌ Gỡ Ảnh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="BtnClearStampImage_Click" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- KHUNG PREVIEW ẢNH CON DẤU THỰC TẾ -->
                                            <Border x:Name="BorderStampPreview" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" MinHeight="75" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <!-- PLACEHOLDER KHI CHƯA CHỌN ẢNH -->
                                                    <StackPanel x:Name="PnlStampPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="⭕ Chưa chọn ảnh con dấu / chữ ký tay" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Nhấn nút 'Chọn Ảnh...' ở trên để nạp tệp con dấu đỏ (.png, .jpg)" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- ẢNH HIỂN THỊ THỰC TẾ KHI ĐÃ CHỌN -->
                                                    <StackPanel x:Name="PnlStampLoaded" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA" Padding="4">
                                                            <Image x:Name="ImgStampPreview" MaxHeight="75" MaxWidth="130" Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtStampFileName" Text="quyen.png" FontWeight="Bold" FontSize="12" Foreground="#047857" />
                                                            <TextBlock x:Name="TxtStampDimensionsInfo" Text="Kích thước: 120x120px" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="TxtStampFullPath" Text="C:\...\quyen.png" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="250" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ĐƯỜNG DẪN ẨN / TƯƠNG THÍCH -->
                                            <TextBox x:Name="TxtStampImagePath" Visibility="Collapsed" />

                                            <!-- HÌNH THỨC HIỂN THỊ CHỮ KÝ (MODE) -->
                                            <TextBlock Text="Hình thức thể hiện khi ký trên tài liệu PDF:" FontSize="11" Foreground="#64748B" Margin="0,2,0,2" />
                                            <ComboBox x:Name="CmbDisplayMode" Padding="5" SelectionChanged="CmbDisplayMode_SelectionChanged">
                                                <ComboBoxItem Content="🔴 Chỉ hình ảnh con dấu / chữ ký tay (Khuyên dùng)" IsSelected="True" />
                                                <ComboBoxItem Content="📝 Ảnh con dấu + Dòng thông tin người ký &amp; ngày giờ" />
                                                <ComboBoxItem Content="📄 Chỉ thông tin văn bản chữ ký số điện tử (Không ảnh)" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- VỊ TRÍ KÝ: TRANG, TỌA ĐỘ -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Trang ký:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtPageNumber" Text="-1" Padding="4" ToolTip="-1 là trang cuối cùng" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tọa độ X:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordX" Text="380" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tọa độ Y:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtCoordY" Text="120" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Rộng x Cao:" FontSize="11" Foreground="#64748B" />
                                            <TextBox x:Name="TxtDimensions" Text="120x120" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Họ tên người ký hiển thị:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSignerDisplayName" Padding="5" Margin="0,0,0,6" />

                                    <TextBlock Text="Lý do ký:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtReason" Text="Ký duyệt phát hành văn bản điện tử" Padding="5" Margin="0,0,0,8" />

                                    <CheckBox x:Name="ChkUseTSA" Content="Đóng Dấu thời gian TSA Ban Cơ yếu (http://ca.gov.vn/tsa)" 
                                              IsChecked="True" FontWeight="Normal" FontSize="11" Margin="0,0,0,12" />

                                    <!-- NÚT LƯU CẤU HÌNH & CHUYỂN SANG TAB SOẠN THẢO -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="💾 Lưu Mẫu Chữ Ký Này" 
                                                Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,4,0" 
                                                Click="BtnSaveProfile_Click" />
                                        <Button Grid.Column="1" Content="👉 Đi Tới Soạn Thảo (Tab 2) ➡" 
                                                Style="{StaticResource PrimaryButton}" Padding="10,8" Margin="4,0,0,0" 
                                                Click="BtnGoToSignWorkspace_Click" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 2: SOẠN THẢO & KÝ SỐ VĂN BẢN TRỰC TIẾP ================= -->
            <TabItem x:Name="TabItemSignWorkspace" Header="  2. Soạn Thảo, Xem &amp; Ký Số Trực Tiếp  " FontSize="14" FontWeight="SemiBold">
                <Grid x:Name="GridTab2Root" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- HÀNG 0: THANH CÔNG CỤ ĐIỀU KHIỂN & SOẠN THẢO TRÊN CÙNG -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 1: BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                        <RowDefinition Height="Auto" />
                        <!-- HÀNG 2: KHUNG HIỂN THỊ TÀI LIỆU TRỰC TIẾP TOÀN MÀN HÌNH -->
                        <RowDefinition Height="*" />
                        <!-- HÀNG 3: NHẬT KÝ TIẾN TRÌNH RÚT GỌN CHÂN TRANG -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ ĐIỀU HÀNH VĂN BẢN (TOOLBAR) -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- DÒNG 1: TẢI FILE & CÁC NÚT HÀNH ĐỘNG CHÍNH -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- NÚT 1: TẢI FILE WORD -->
                                <Button Grid.Column="0" Content="📄 Tải File Word (.docx)" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Click="BtnSelectWord_Click" Margin="0,0,8,0" />

                                <!-- NÚT 2: TẢI FILE PDF TRỰC TIẾP -->
                                <Button Grid.Column="1" Content="📑 Tải File PDF" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Click="BtnSelectPdf_Click" Margin="0,0,12,0" />

                                <!-- TÊN FILE & TRẠNG THÁI HIỆN TẠI -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtCurrentFileName" Text="Chưa chọn tệp tin nào." FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                    <TextBlock x:Name="TxtCurrentFileStatus" Text="Chọn file Word hoặc PDF để xem trực tiếp tại đây." FontSize="11" Foreground="#64748B" />
                                </StackPanel>

                                <!-- NÚT 3: CHUYỂN QUA PDF ĐỂ KÝ -->
                                <Button Grid.Column="3" x:Name="BtnConvertToPdfAndReadySign" 
                                        Content="⚡ Chuyển Qua PDF Để Ký" 
                                        Style="{StaticResource ConvertButton}" 
                                        IsEnabled="False" Margin="0,0,8,0" 
                                        Click="BtnExecuteConvertWord_Click" />

                                <!-- NÚT 4: CHÈN CHỮ KÝ (KÉO THẢ TRỰC TIẾP TRÊN TRANG VĂN BẢN) -->
                                <Button Grid.Column="4" x:Name="BtnInsertSignatureStamp" 
                                        Content="📍 Chèn Chữ Ký" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold" 
                                        IsEnabled="False" Margin="0,0,8,0" 
                                        Click="BtnInsertSignatureStamp_Click" />

                                <!-- NÚT 5: TIẾN HÀNH KÝ SỐ TÀI LIỆU -->
                                <Button Grid.Column="5" x:Name="BtnSignCurrentDocument" 
                                        Content="✍ TIẾN HÀNH KÝ SỐ" 
                                        Style="{StaticResource SignButton}" 
                                        IsEnabled="False" 
                                        Click="BtnSignDocument_Click" />
                            </Grid>

                            <!-- DÒNG 2: THANH CÔNG CỤ ĐIỀU CHỈNH VĂN BẢN TRỰC TIẾP (KHI MỞ FILE WORD) -->
                            <Grid Grid.Row="1" x:Name="PnlEditingToolbar" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock Text="✏ Chế độ xem &amp; chỉnh sửa trực tiếp Word" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                    </Border>
                                    <Button Content="B" ToolTip="In đậm (Bold)" Style="{StaticResource FormatButton}" Click="BtnFormatBold_Click" />
                                    <Button Content="I" ToolTip="In nghiêng (Italic)" Style="{StaticResource FormatButton}" FontStyle="Italic" Click="BtnFormatItalic_Click" />
                                    <Button Content="U" ToolTip="Gạch chân (Underline)" Style="{StaticResource FormatButton}" Click="BtnFormatUnderline_Click" />
                                    <Separator Width="1" Height="16" Margin="6,0" Background="#CBD5E1" />
                                    <Button Content="⇤ Trái" ToolTip="Căn lề trái" Style="{StaticResource FormatButton}" Click="BtnAlignLeft_Click" />
                                    <Button Content="↔ Giữa" ToolTip="Căn giữa" Style="{StaticResource FormatButton}" Click="BtnAlignCenter_Click" />
                                    <Button Content="⇥ Phải" ToolTip="Căn lề phải" Style="{StaticResource FormatButton}" Click="BtnAlignRight_Click" />
                                    <Button Content="⇿ Đều" ToolTip="Căn đều hai bên" Style="{StaticResource FormatButton}" Click="BtnAlignJustify_Click" />
                                </StackPanel>

                                <!-- THANH LOADING CHUYỂN ĐỔI -->
                                <ProgressBar Grid.Column="2" x:Name="PrgConvertLoading" Height="4" IsIndeterminate="True" 
                                             Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Foreground="#D97706" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- CHIP HIỂN THỊ ẢNH CON DẤU TRÊN TAB 2 -->
                                    <Border x:Name="BadgeTab2Stamp" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="ImgTab2StampThumb" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="TxtTab2StampStatus" Text="🔴 Con dấu: Chưa chọn" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                            <Button x:Name="BtnTab2SelectStamp" Content="🖼 Đổi ảnh..." Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="6,0,0,0" FontSize="10" Click="BtnTab2ChangeStamp_Click" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtQuickCertNotice" Text="Chứng thư: Hà Văn Tý (Ban Cơ yếu G2)" 
                                               FontSize="11" FontWeight="Medium" Foreground="#059669" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BANNER THÀNH CÔNG VÀ CÁC NÚT THAO TÁC NHANH SAU KHI KÝ -->
                    <Border Grid.Row="1" x:Name="BorderSignSuccessBanner" Visibility="Collapsed" 
                            Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="VĂN BẢN ĐÃ KÝ SỐ THÀNH CÔNG (CHUẨN PAdES LTV BAN CƠ YẾU CHÍNH PHỦ)" 
                                               FontWeight="Bold" Foreground="#065F46" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtSignedSummaryNotice" Text="Tài liệu đã ký được hiển thị trực tiếp bên dưới để kiểm tra con dấu và nội dung." 
                                           FontSize="11" Foreground="#047857" Margin="22,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 Lưu Bản Sao..." Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnSaveSignedCopy_Click" />
                                <Button Content="📂 Mở Tệp Đã Ký" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedPdfExternal_Click" />
                                <Button Content="📁 Mở Thư Mục" Style="{StaticResource SecondaryButton}" 
                                        Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="BtnOpenSignedFolder_Click" />
                                <Button Content="🌐 Đưa Lên Cổng Web (Tab 3) ➡" Style="{StaticResource SuccessButton}" 
                                        Padding="12,5" FontSize="11" FontWeight="Bold" Click="BtnGoToUploadWeb_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KHUNG XEM TRƯỚC VÀ CHỈNH SỬA VĂN BẢN TRỰC TIẾP (WEBVIEW2 CANVAS) -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <wv2:WebView2 x:Name="PdfPreviewControl" />
                            
                            <Border x:Name="PnlPreviewPlaceholder" Background="#F8FAFC" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="56" HorizontalAlignment="Center" Foreground="#94A3B8" />
                                    <TextBlock Text="KHÔNG GIAN HIỂN THỊ &amp; SOẠN THẢO VĂN BẢN TRỰC TIẾP" FontWeight="Bold" FontSize="16" Foreground="#334155" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                    <TextBlock Text="Tải file Word (.docx) hoặc PDF lên. Nội dung sẽ được hiển thị nguyên bản tại đây cho phép bạn đọc, điều chỉnh nội dung trực tiếp trước khi ký." 
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" MaxWidth="600" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- NHẬT KÝ HOẠT ĐỘNG RÚT GỌN -->
                    <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIẾN TRÌNH: " FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" x:Name="TxtStatusBar" Text="Sẵn sàng." FontSize="11" Foreground="#E2E8F0" FontFamily="Consolas" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- OVERLAY KHI CHƯA ĐĂNG NHẬP VGCA (KHÓA TOÀN BỘ TAB 2 KHI CHƯA XÁC THỰC) -->
                    <Border x:Name="OverlayTab2Locked" Grid.RowSpan="4" Background="#F1F5F9" Visibility="Collapsed" Panel.ZIndex="100">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" 
                                MaxWidth="580" MaxHeight="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="CHỨC NĂNG KÝ SỐ ĐANG BỊ TẠM KHÓA" FontWeight="Bold" FontSize="16" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Để đảm bảo an toàn pháp lý và tính toàn vẹn theo quy chuẩn của Ban Cơ yếu Chính phủ, bạn cần đăng nhập tài khoản chữ ký số VGCA Virtual CSP tại Tab 1 trước khi thực hiện soạn thảo và ký số văn bản." 
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#64748B" LineHeight="20" Margin="0,0,0,20" />
                                <Button Content="🔑 Chuyển Sang Tab 1 Để Đăng Nhập Ngay" Style="{StaticResource PrimaryButton}" 
                                        Background="#1E40AF" FontSize="14" FontWeight="Bold" Padding="20,12" Click="BtnGoToLoginTab_Click" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: GỬI LÊN WEB ================= -->
            <TabItem Header="  3. Gửi File Lên Cổng Web  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Cấu Hình Gói Tin Đẩy Lên Cổng Web">
                        <StackPanel Margin="6">
                            <TextBlock Text="Tệp PDF đã ký cần gửi:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtUploadFilePath" Background="#F8FAFC" Padding="6" Text="Chưa có file nào sẵn sàng..." />
                                <Button Grid.Column="1" Content="📁 Chọn File..." Style="{StaticResource SecondaryButton}" 
                                        Margin="6,0,0,0" Click="BtnSelectSignedPdfForUpload_Click" />
                            </Grid>

                            <TextBlock Text="Địa chỉ URL Web Gateway tiếp nhận (HTTP/HTTPS):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtUploadUrl" Text="https://httpbin.org/post" Padding="6" Margin="0,0,0,8" />

                            <TextBlock Text="Mã định danh Token / Bearer Key (nếu có):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtAuthToken" Text="Bearer vgca-secure-token-2026" Padding="6" Margin="0,0,0,8" />

                            <TextBlock Text="Tiêu đề văn bản:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                            <TextBox x:Name="TxtUploadDocTitle" Text="Văn bản đã ký duyệt" Padding="6" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Người ký:" FontSize="11" Foreground="#64748B" />
                                    <TextBox x:Name="TxtUploadSigner" Padding="6" Text="Hà Văn Tý" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Đơn vị / Phòng ban:" FontSize="11" Foreground="#64748B" />
                                    <TextBox x:Name="TxtUploadDepartment" Text="Trường THCS Chu Văn An" Padding="6" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnExecuteUpload" Content="🚀 TIẾN HÀNH GỬI TÀI LIỆU LÊN CỔNG WEB" 
                                    Style="{StaticResource SuccessButton}" 
                                    FontSize="13" Padding="16,10" Margin="0,10,0,0" 
                                    Click="BtnExecuteUpload_Click" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Phản Hồi Mạng Thật Từ Máy Chủ (Live HTTP Response Trace)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Trạng thái HTTP: " FontWeight="Bold" Foreground="#334155" />
                                    <TextBlock x:Name="TxtHttpStatus" Text="Chưa gửi yêu cầu" FontWeight="Bold" Foreground="#64748B" Margin="0,0,20,0" />
                                    <TextBlock Text="Thời gian phản hồi: " FontWeight="Bold" Foreground="#334155" />
                                    <TextBlock x:Name="TxtHttpLatency" Text="0 ms" FontWeight="Bold" Foreground="#0284C7" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                <TextBox x:Name="TxtHttpResponseContent" 
                                         Background="Transparent" Foreground="#38BDF8" 
                                         BorderThickness="0" FontFamily="Consolas" FontSize="11" 
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" 
                                         Text="Chưa có dữ liệu phản hồi từ máy chủ." />
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: KIỂM TRA CHỮ KÝ ================= -->
            <TabItem Header="  4. Kiểm Tra Chữ Ký (Verify)  " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Chọn File PDF Cần Kiểm Tra Tính Toàn Vẹn &amp; Pháp Lý">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtVerifyPdfPath" Background="#F8FAFC" Padding="6" Text="Chọn file PDF để kiểm tra..." />
                            <Button Grid.Column="1" Content="🔍 Mở File &amp; Xác Minh" Style="{StaticResource PrimaryButton}" 
                                    Margin="8,0,0,0" Click="BtnVerifyPdf_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Danh Sách Các Chữ Ký Số Phát Hiện Trong Tài Liệu">
                        <ListView x:Name="ListSignatures" Background="White" BorderThickness="0" Margin="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Trạng thái" Width="100" DisplayMemberBinding="{Binding IsValid}" />
                                    <GridViewColumn Header="Người ký" Width="220" DisplayMemberBinding="{Binding SignerName}" />
                                    <GridViewColumn Header="Ngày ký" Width="150" DisplayMemberBinding="{Binding SignDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Dấu thời gian (TSA)" Width="150" DisplayMemberBinding="{Binding TimestampDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                                    <GridViewColumn Header="Bảo vệ toàn vẹn" Width="120" DisplayMemberBinding="{Binding CoversWholeDocument}" />
                                    <GridViewColumn Header="Chi tiết chứng thư" Width="400" DisplayMemberBinding="{Binding Details}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="VGCA Sign Tool Pro • Tích hợp Chứng thực số Ban Cơ yếu Chính phủ" FontSize="11" Foreground="#475569" />
                <TextBlock Grid.Column="1" Text="Phiên bản 3.6.0 Pro • .NET 8 x64" FontSize="11" Foreground="#64748B" />
            </Grid>
        </Border>
    </Grid>
</Window>
