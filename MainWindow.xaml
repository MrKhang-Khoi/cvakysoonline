<Window x:Class="VGCASignToolPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Controls.RichTextBoxAdv;assembly=Syncfusion.SfRichTextBoxAdv.Wpf"
        mc:Ignorable="d"
        Title="VGCA Sign Tool Pro - Hệ Thống Ký Số Điện Tử &amp; Soạn Thảo Văn Bản Tích Hợp" 
        Icon="app_icon.ico"
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Chính (Xanh dương) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#94A3B8" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Chuyển đổi (Cam / Hổ phách) -->
        <Style x:Key="ConvertButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B45309" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Ký số Cá nhân (Xanh dương hoàng gia - Primary Action) -->
        <Style x:Key="SignButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Đóng Dấu Pháp Nhân Cơ Quan (Đỏ Quốc Gia Ban Cơ Yếu) -->
        <Style x:Key="OfficialSealButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Word (Xanh dương nhẹ) -->
        <Style x:Key="ToolbarWordButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E40AF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File Excel (Xanh lá cây nhẹ) -->
        <Style x:Key="ToolbarExcelButton" TargetType="Button">
            <Setter Property="Background" Value="#F0FDF4" />
            <Setter Property="BorderBrush" Value="#BBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#15803D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Mở File PDF (Xám thanh lịch) -->
        <Style x:Key="ToolbarPdfButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Thành công (Xanh lá) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#10B981" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Phụ (Xám nhạt) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CBD5E1" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Soạn thảo Mini -->
        <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>

        <!-- STYLE TABCONTROL CHUẨN MICROSOFT FLUENT DESIGN (SEGMENTED NAVIGATION BAR) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- THANH ĐIỀU HƯỚNG TABS TÁCH BIỆT (FLUENT SEGMENTED TRACK) -->
                            <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="8" Padding="5" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            
                            <!-- VÙNG NỘI DUNG CHÍNH (CONTENT PRESENTER) -->
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TABITEM CHUẨN MICROSOFT FLUENT DESIGN (HIGH-CONTRAST ACCENT PILL) -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="Transparent" 
                                CornerRadius="6" 
                                Padding="18,8"
                                BorderThickness="0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- KHI DI CHUỘT QUA TAB CHƯA CHỌN (HOVER) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </MultiTrigger>
                            
                            <!-- KHI ĐƯỢC CHỌN (SELECTED - ĐỔI MÀU NỔI BẬT CHUẨN MICROSOFT FLUENT) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            
                            <!-- KHI BỊ KHÓA (DISABLED) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TIÊU ĐỀ CỘT BẢNG (GRIDVIEW COLUMN HEADER) CHUẨN HIỆN ĐẠI -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-2,0" Width="4">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" Width="4" Cursor="SizeWE" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE DÒNG DANH SÁCH (LISTVIEWITEM) CHUẨN MICROSOFT FLUENT UI - CHỐNG NHẤP NHÁY VÀ GIẬT LAG TUYỆT ĐỐI -->
        <Style TargetType="ListViewItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <!-- Lớp 1: Nền dòng độc lập (Background Border) - Thay đổi màu sắc khi Hover/Select hoàn toàn không kích hoạt InvalidateVisual/LayoutPass lên GridViewRowPresenter -->
                            <Border x:Name="ItemRowBackground"
                                    Background="#FFFFFF"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True" />

                            <!-- Lớp 2: Nội dung các cột (GridViewRowPresenter) cố định đệm và không bị re-layout khi đổi màu nền -->
                            <Border Padding="10,6" Background="Transparent" SnapsToDevicePixels="True">
                                <GridViewRowPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            </Border>

                            <!-- Lớp 3: Dải định vị Accent mép trái chuẩn Windows 11 Fluent UI -->
                            <Border x:Name="AccentIndicator"
                                    Width="3.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    CornerRadius="0,2,2,0"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- KHI RÊ CHUỘT (CHỈ KHI CHƯA CHỌN): NỀN XÁM NHẸ MỊN MÀNG -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemRowBackground" Property="Background" Value="#F8FAFC" />
                            </MultiTrigger>
                            <!-- KHI ĐƯỢC CHỌN (SELECTED): NỀN XANH NHẠT CAO CẤP + THANH ACCENT MẼP TRÁI, CỐ ĐỊNH 1 MÀU DUY NHẤT TRIỆT TIÊU CHỚP MÀU -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRowBackground" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="ItemRowBackground" Property="BorderBrush" Value="#DBEAFE" />
                                <Setter TargetName="AccentIndicator" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <!-- KHI VÔ HIỆU HÓA -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemRowBackground" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VGCA SIGN TOOL PRO" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Ký số PAdES Ban Cơ yếu Chính phủ • Soạn thảo &amp; Xem trực tiếp Word/PDF • Cổng Web" 
                               FontSize="12" Foreground="#93C5FD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- NÚT KIỂM TRA CẬP NHẬT PHIÊN BẢN MỚI TỪ FIREBASE -->
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" 
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,6" Margin="0,0,10,0" Cursor="Hand" ToolTip="Kiểm tra phiên bản cập nhật mới từ hệ thống nhà trường (Firebase &amp; GitHub)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtUpdateStatusHeader" Text="Kiểm Tra Cập Nhật" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- BADGE TRẠNG THÁI VGCA TOÀN CỤC -->
                    <Border x:Name="BadgeVgcaGlobalStatus" Background="#B91C1C" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtVgcaGlobalStatusIcon" Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtVgcaGlobalStatusText" Text="VGCA: Chưa Đăng Nhập" 
                                       Foreground="#FEF2F2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14,10,14,10" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ================= TAB 1: THÔNG TIN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <!-- ================= TAB 1: THÔNG TIN NHẬN DIỆN CHỮ KÝ SỐ (VGCA & PROFILES) ================= -->
            <TabItem Header="  1. 👤 Nhận Diện Chữ Ký Số  " FontSize="13" FontWeight="SemiBold">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="520" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: KHUNG THÔNG TIN NHẬN DIỆN CHỨNG THƯ VGCA & PHÂN QUYỀN FIREBASE -->
                        <StackPanel Grid.Column="0">
                            <GroupBox x:Name="GrpVgcaActiveCard" Header="Thông Tin Nhận Diện Chữ Ký Số VGCA (Ban Cơ Yếu Chính Phủ)" Visibility="Visible">
                                <StackPanel Margin="4">
                                    <!-- BANNER XÁC THỰC HOẶC CẢNH BÁO TRẠNG THÁI CSP / TOKEN -->
                                    <Border x:Name="BorderDetailBanner" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtDetailBannerIcon" Text="🛡️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtDetailBannerTitle" Text="ĐÃ NHẬN DIỆN THIẾT BỊ KÝ SỐ BAN CƠ YẾU" FontWeight="Bold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtDetailBannerSubtitle" Text="Tự động phân quyền ký số và đóng dấu theo số CCCD từ hệ thống nhà trường." FontSize="11" Foreground="#166534" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnDetailOpenVcsp" Content="🖥️ Mở Công Cụ VGCA" Style="{StaticResource SecondaryButton}" 
                                                        Background="#FEF3C7" BorderBrush="#FCD34D" Foreground="#B45309" FontWeight="Bold" 
                                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnLaunchVgcaManager_Click"
                                                        ToolTip="Bấm để mở VGCA Virtual CSP Manager hoặc USB Token Sign Tool (Hoặc chuột phải để chọn thao tác)">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🖥️ Mở Virtual CSP Manager (Ký số từ xa qua điện thoại)" Click="MenuOpenVcspManager_Click" FontWeight="Bold" />
                                                            <Separator />
                                                            <MenuItem Header="📦 Cài đặt VGCA Virtual CSP v2.0 (VGCA_VCSPInstaller.exe)" Click="MenuInstallVcsp_Click" />
                                                            <MenuItem Header="🔑 Cài đặt VGCA Sign Tool v3.0.6 (USB Token phần cứng - .msi)" Click="MenuInstallVgcaSignTool_Click" />
                                                            <Separator />
                                                            <MenuItem Header="⚡ Mở VGCA Sign Tool v3.0.6 (USB Token)" Click="MenuOpenVgcaSignTool_Click" />
