<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2.1.6</Version>
    <AssemblyVersion>2.1.6.0</AssemblyVersion>
    <FileVersion>2.1.6.0</FileVersion>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="itext7" Version="9.7.0" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.7.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Syncfusion.DocToPDFConverter.Wpf" Version="28.2.9" />
    <PackageReference Include="Syncfusion.SfRichTextBoxAdv.WPF" Version="28.2.9" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Updater\**" />
    <EmbeddedResource Remove="Updater\**" />
    <None Remove="Updater\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="school_roster.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="workflow_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

  <Target Name="BuildAndCopyUpdater" AfterTargets="Build">
    <MSBuild Projects="Updater\VGCASignToolPro.Updater.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU" />
    <ItemGroup>
      <UpdaterFiles Include="Updater\bin\$(Configuration)\net8.0-windows\VGCASignToolPro.Updater.*" />
      <UpdaterFiles Include="Updater\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\VGCASignToolPro.Updater.*" Condition="'$(RuntimeIdentifier)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyUpdaterToPublishDir" AfterTargets="Publish">
    <MSBuild Projects="Updater\VGCASignToolPro.Updater.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <UpdaterPublishFiles Include="Updater\bin\$(Configuration)\net8.0-windows\VGCASignToolPro.Updater.*" />
      <UpdaterPublishFiles Include="Updater\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\VGCASignToolPro.Updater.*" Condition="'$(RuntimeIdentifier)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
